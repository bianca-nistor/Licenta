<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="JobCv.Mobile.MainPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#F8FAFC">

    <ScrollView>
        <Grid Padding="24,14,24,24"
              RowDefinitions="Auto,*">

            <VerticalStackLayout Grid.Row="0"
                                 Spacing="8"
                                 Margin="0,8,0,18"
                                 HorizontalOptions="Center"
                                 MaximumWidthRequest="520">

                <Label Text="Career Guide"
                       FontSize="32"
                       FontAttributes="Bold"
                       TextColor="#0F172A"
                       HorizontalTextAlignment="Center" />

                <Label Text="Creează CV-uri mai bune, urmărește aplicările și pregătește-te pentru interviuri."
                       FontSize="15"
                       TextColor="#64748B"
                       HorizontalTextAlignment="Center"
                       LineBreakMode="WordWrap" />

            </VerticalStackLayout>

            <Border Grid.Row="1"
                    BackgroundColor="White"
                    Stroke="#E2E8F0"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 30"
                    Padding="24"
                    HorizontalOptions="Center"
                    MaximumWidthRequest="520">

                <VerticalStackLayout Spacing="16">

                    <VerticalStackLayout Spacing="4">
                        <Label Text="Bine ai revenit"
                               FontSize="24"
                               FontAttributes="Bold"
                               TextColor="#0F172A" />

                        <Label Text="Autentifică-te pentru a-ți continua progresul în carieră."
                               FontSize="14"
                               TextColor="#64748B"
                               LineBreakMode="WordWrap" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="6">
                        <Label Text="Email"
                               FontSize="14"
                               FontAttributes="Bold"
                               TextColor="#0F172A" />

                        <Entry x:Name="EmailEntry"
                               Placeholder="Introdu emailul"
                               Keyboard="Email"
                               TextColor="#0F172A"
                               PlaceholderColor="#94A3B8"
                               BackgroundColor="#F8FAFC"
                               HeightRequest="50"
                               Margin="0" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="6">
                        <Label Text="Parolă"
                               FontSize="14"
                               FontAttributes="Bold"
                               TextColor="#0F172A" />

                        <Entry x:Name="PasswordEntry"
                               Placeholder="Introdu parola"
                               IsPassword="True"
                               TextColor="#0F172A"
                               PlaceholderColor="#94A3B8"
                               BackgroundColor="#F8FAFC"
                               HeightRequest="50"
                               Margin="0" />
                    </VerticalStackLayout>

                    <Label x:Name="MessageLabel"
                           Text=""
                           TextColor="#DC2626"
                           FontSize="13"
                           HorizontalTextAlignment="Center" />

                    <Button Text="Autentificare"
                            Clicked="OnLoginClicked"
                            BackgroundColor="#1D4ED8"
                            TextColor="White"
                            FontAttributes="Bold"
                            CornerRadius="16"
                            HeightRequest="52" />

                    <Button Text="Creează cont nou"
                            Clicked="OnGoToRegisterClicked"
                            BackgroundColor="#DCFCE7"
                            TextColor="#166534"
                            FontAttributes="Bold"
                            CornerRadius="16"
                            HeightRequest="52" />

                    <Label Text="Asistentul tău personal pentru CV-uri, joburi, aplicări și interviuri."
                           FontSize="13"
                           TextColor="#64748B"
                           HorizontalTextAlignment="Center"
                           Margin="0,4,0,0"
                           LineBreakMode="WordWrap" />

                </VerticalStackLayout>
            </Border>

        </Grid>
    </ScrollView>
</ContentPage>
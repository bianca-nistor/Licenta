<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="JobCv.Mobile.Pages.UploadCvPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#F8FAFC">

    <ScrollView>
        <VerticalStackLayout Padding="24"
                             Spacing="20">

            <Grid ColumnDefinitions="Auto,*"
                  Margin="0,20,0,0">

                <Button Text="←"
                        Clicked="OnBackClicked"
                        BackgroundColor="#E2E8F0"
                        TextColor="#0F172A"
                        CornerRadius="18"
                        WidthRequest="44"
                        HeightRequest="44" />

                <VerticalStackLayout Grid.Column="1"
                                     Margin="14,0,0,0"
                                     Spacing="4">

                    <Label Text="Upload CV"
                           FontSize="32"
                           FontAttributes="Bold"
                           TextColor="#0F172A" />

                    <Label Text="Upload an existing PDF, DOC or DOCX CV."
                           FontSize="14"
                           TextColor="#64748B" />
                </VerticalStackLayout>
            </Grid>

            <Border BackgroundColor="White"
                    Stroke="#E2E8F0"
                    StrokeShape="RoundRectangle 26"
                    Padding="22">

                <VerticalStackLayout Spacing="16">

                    <Label Text="Choose your file"
                           FontSize="22"
                           FontAttributes="Bold"
                           TextColor="#0F172A" />

                    <Label Text="Accepted formats: PDF, DOC, DOCX. Maximum size: 10 MB."
                           FontSize="14"
                           TextColor="#64748B" />

                    <Border BackgroundColor="#F8FAFC"
                            Stroke="#E2E8F0"
                            StrokeShape="RoundRectangle 18"
                            Padding="16">

                        <VerticalStackLayout Spacing="6">
                            <Label Text="Selected file"
                                   FontSize="13"
                                   TextColor="#64748B" />

                            <Label x:Name="SelectedFileLabel"
                                   Text="No file selected"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   TextColor="#0F172A" />
                        </VerticalStackLayout>
                    </Border>

                    <Grid ColumnDefinitions="*,*"
                          ColumnSpacing="12">

                        <Button Text="Choose file"
                                Clicked="OnChooseFileClicked"
                                BackgroundColor="#DCFCE7"
                                TextColor="#166534"
                                FontAttributes="Bold"
                                CornerRadius="16"
                                HeightRequest="54" />

                        <Button Grid.Column="1"
                                Text="Upload"
                                Clicked="OnUploadClicked"
                                BackgroundColor="#1D4ED8"
                                TextColor="White"
                                FontAttributes="Bold"
                                CornerRadius="16"
                                HeightRequest="54" />
                    </Grid>

                    <Label x:Name="MessageLabel"
                           Text=""
                           FontSize="13"
                           TextColor="#DC2626" />
                </VerticalStackLayout>
            </Border>

            <Border BackgroundColor="White"
                    Stroke="#E2E8F0"
                    StrokeShape="RoundRectangle 26"
                    Padding="20">

                <VerticalStackLayout Spacing="14">

                    <Label Text="Uploaded CV files"
                           FontSize="22"
                           FontAttributes="Bold"
                           TextColor="#0F172A" />

                    <CollectionView x:Name="UploadedFilesCollectionView"
                                    SelectionMode="None">

                        <CollectionView.EmptyView>
                            <VerticalStackLayout Padding="20"
                                                 Spacing="6"
                                                 HorizontalOptions="Center">
                                <Label Text="No uploaded files yet"
                                       FontSize="18"
                                       FontAttributes="Bold"
                                       TextColor="#0F172A"
                                       HorizontalTextAlignment="Center" />

                                <Label Text="Upload your first existing CV file."
                                       FontSize="14"
                                       TextColor="#64748B"
                                       HorizontalTextAlignment="Center" />
                            </VerticalStackLayout>
                        </CollectionView.EmptyView>

                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border BackgroundColor="#F8FAFC"
                                        Stroke="#E2E8F0"
                                        StrokeShape="RoundRectangle 18"
                                        Padding="14"
                                        Margin="0,0,0,10">

                                    <VerticalStackLayout Spacing="10">

                                        <VerticalStackLayout Spacing="3">
                                            <Label Text="{Binding OriginalFileName}"
                                                   FontSize="16"
                                                   FontAttributes="Bold"
                                                   TextColor="#0F172A" />

                                            <Label Text="{Binding DisplaySize}"
                                                   FontSize="13"
                                                   TextColor="#64748B" />
                                        </VerticalStackLayout>

                                        <Grid ColumnDefinitions="*,*"
                                              ColumnSpacing="10">

                                            <Button Text="Open"
                                                    Clicked="OnOpenUploadedFileClicked"
                                                    CommandParameter="{Binding Id}"
                                                    BackgroundColor="#EFF6FF"
                                                    TextColor="#1D4ED8"
                                                    FontAttributes="Bold"
                                                    CornerRadius="14"
                                                    HeightRequest="46" />

                                            <Button Grid.Column="1"
                                                    Text="Delete"
                                                    Clicked="OnDeleteUploadedFileClicked"
                                                    CommandParameter="{Binding Id}"
                                                    BackgroundColor="#FEE2E2"
                                                    TextColor="#DC2626"
                                                    FontAttributes="Bold"
                                                    CornerRadius="14"
                                                    HeightRequest="46" />
                                        </Grid>
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
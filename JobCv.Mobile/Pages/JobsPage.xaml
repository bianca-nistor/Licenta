<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="JobCv.Mobile.Pages.JobsPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#F1F5F9">

    <ScrollView>
        <VerticalStackLayout Padding="24"
                             Spacing="22">

            <!-- Header -->
            <Grid ColumnDefinitions="Auto,*,Auto"
                  ColumnSpacing="14"
                  Margin="0,30,0,0">

                <Button Grid.Column="0"
                        Text="☰"
                        Clicked="OnMenuClicked"
                        BackgroundColor="#E2E8F0"
                        TextColor="#0F172A"
                        CornerRadius="18"
                        WidthRequest="48"
                        HeightRequest="48"
                        FontSize="22"
                        VerticalOptions="Start" />

                <VerticalStackLayout Grid.Column="1"
                                     Spacing="4">
                    <Label x:Name="PageTitleLabel"
       Text="Find Jobs"
       FontSize="34"
       FontAttributes="Bold"
       TextColor="#0F172A"
       MaxLines="2"
       LineBreakMode="WordWrap" />

                    <Label Text="Search jobs, filter results and open details before applying."
                           FontSize="16"
                           TextColor="#64748B"
                           LineBreakMode="WordWrap" />

                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="2"
                                     HorizontalOptions="End"
                                     VerticalOptions="Start"
                                     Spacing="8">

                    <Button Text="👤"
            Clicked="OnProfileClicked"
            BackgroundColor="#DCFCE7"
            TextColor="#0F172A"
            CornerRadius="22"
            WidthRequest="48"
            HeightRequest="48"
            FontSize="18" />
                    <Border x:Name="ProfileMenu"
                            IsVisible="False"
                            BackgroundColor="White"
                            Stroke="#E2E8F0"
                            StrokeShape="RoundRectangle 18"
                            Padding="12"
                            WidthRequest="210"
                            Shadow="5,5,12,#22000000">

                        <VerticalStackLayout Spacing="8">

                            <Label Text="Profile"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   TextColor="#0F172A"
                                   Margin="4,0,4,6" />

                            <Button Text="View profile"
                                    Clicked="OnViewProfileClicked"
                                    BackgroundColor="#EFF6FF"
                                    TextColor="#1D4ED8"
                                    CornerRadius="12"
                                    HeightRequest="44" />

                            <Button Text="Logout"
                                    Clicked="OnLogoutClicked"
                                    BackgroundColor="#FEE2E2"
                                    TextColor="#DC2626"
                                    CornerRadius="12"
                                    HeightRequest="44" />

                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>
            </Grid>

            <!-- Hamburger menu -->
            <Border x:Name="MainMenu"
                    IsVisible="False"
                    BackgroundColor="White"
                    Stroke="#E2E8F0"
                    StrokeShape="RoundRectangle 22"
                    Padding="14"
                    Shadow="5,5,12,#22000000">

                <VerticalStackLayout Spacing="10">

                    <Label Text="Menu"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="#0F172A"
                           Margin="4,0,4,4" />

                    <Button Text="Dashboard"
                            Clicked="OnDashboardClicked"
                            BackgroundColor="#EFF6FF"
                            TextColor="#1D4ED8"
                            FontAttributes="Bold"
                            CornerRadius="14"
                            HeightRequest="46" />

                    <Button Text="My CVs"
                            Clicked="OnMyCvsClicked"
                            BackgroundColor="#EFF6FF"
                            TextColor="#1D4ED8"
                            FontAttributes="Bold"
                            CornerRadius="14"
                            HeightRequest="46" />

                    <Button Text="Applications"
                            Clicked="OnMyApplicationsClicked"
                            BackgroundColor="#EFF6FF"
                            TextColor="#1D4ED8"
                            FontAttributes="Bold"
                            CornerRadius="14"
                            HeightRequest="46" />

                    <Button Text="Jobs"
                            Clicked="OnFindJobsClicked"
                            BackgroundColor="#1D4ED8"
                            TextColor="White"
                            FontAttributes="Bold"
                            CornerRadius="14"
                            HeightRequest="46" />

                </VerticalStackLayout>
            </Border>

            <!-- Search card -->
            <Border BackgroundColor="White"
                    Stroke="#E2E8F0"
                    StrokeShape="RoundRectangle 28"
                    Padding="22">

                <VerticalStackLayout Spacing="16">

                    <Label Text="Search jobs"
                           FontSize="23"
                           FontAttributes="Bold"
                           TextColor="#0F172A" />

                    <Label Text="Enter a role and location, then refine results using filters."
                           FontSize="14"
                           TextColor="#64748B"
                           LineBreakMode="WordWrap" />

                    <Grid ColumnDefinitions="*,*"
                          ColumnSpacing="12">

                        <VerticalStackLayout Spacing="6">

                            <Label Text="Keyword"
                                   FontSize="13"
                                   FontAttributes="Bold"
                                   TextColor="#334155" />

                            <Entry x:Name="QueryEntry"
                                   Placeholder="e.g. .NET developer"
                                   BackgroundColor="#F8FAFC"
                                   TextColor="#0F172A"
                                   PlaceholderColor="#94A3B8"
                                   Completed="OnSearchCompleted" />

                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="1"
                                             Spacing="6">

                            <Label Text="Location"
                                   FontSize="13"
                                   FontAttributes="Bold"
                                   TextColor="#334155" />

                            <Entry x:Name="LocationEntry"
                                   Placeholder="e.g. Bucharest"
                                   BackgroundColor="#F8FAFC"
                                   TextColor="#0F172A"
                                   PlaceholderColor="#94A3B8"
                                   Completed="OnSearchCompleted" />

                        </VerticalStackLayout>
                    </Grid>

                    <Button Text="Search jobs"
                            Clicked="OnSearchClicked"
                            BackgroundColor="#1D4ED8"
                            TextColor="White"
                            FontAttributes="Bold"
                            CornerRadius="16"
                            HeightRequest="54" />

                    <Label x:Name="SearchMessageLabel"
                           Text=""
                           FontSize="13"
                           TextColor="#64748B"
                           HorizontalTextAlignment="Center"
                           LineBreakMode="WordWrap" />

                </VerticalStackLayout>
            </Border>

            <!-- Filters card -->
            <Border BackgroundColor="White"
                    Stroke="#E2E8F0"
                    StrokeShape="RoundRectangle 28"
                    Padding="22">

                <VerticalStackLayout Spacing="16">

                    <Grid ColumnDefinitions="*,Auto"
                          ColumnSpacing="12">

                        <VerticalStackLayout Spacing="4">

                            <Label Text="Filters"
                                   FontSize="23"
                                   FontAttributes="Bold"
                                   TextColor="#0F172A" />

                            <Label x:Name="FilterSummaryLabel"
                                   Text="Filters are applied after a search."
                                   FontSize="14"
                                   TextColor="#64748B"
                                   LineBreakMode="WordWrap" />

                        </VerticalStackLayout>

                        <Border Grid.Column="1"
                                BackgroundColor="#EFF6FF"
                                Stroke="#BFDBFE"
                                StrokeShape="RoundRectangle 16"
                                Padding="12,8"
                                VerticalOptions="Start">

                            <Label x:Name="JobsCountLabel"
                                   Text="0"
                                   FontSize="15"
                                   FontAttributes="Bold"
                                   TextColor="#1D4ED8" />

                        </Border>
                    </Grid>

                    <Grid ColumnDefinitions="*,*"
                          RowDefinitions="Auto,Auto"
                          ColumnSpacing="12"
                          RowSpacing="12">

                        <VerticalStackLayout Spacing="6">

                            <Label Text="Work mode"
                                   FontSize="13"
                                   FontAttributes="Bold"
                                   TextColor="#334155" />

                            <Picker x:Name="WorkModePicker"
                                    SelectedIndexChanged="OnFiltersChanged"
                                    BackgroundColor="#F8FAFC"
                                    TextColor="#0F172A"
                                    TitleColor="#64748B">
                                <Picker.Items>
                                    <x:String>All</x:String>
                                    <x:String>Remote</x:String>
                                    <x:String>Hybrid</x:String>
                                    <x:String>On-site</x:String>
                                </Picker.Items>
                            </Picker>

                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="1"
                                             Spacing="6">

                            <Label Text="Salary"
                                   FontSize="13"
                                   FontAttributes="Bold"
                                   TextColor="#334155" />

                            <Picker x:Name="SalaryFilterPicker"
                                    SelectedIndexChanged="OnFiltersChanged"
                                    BackgroundColor="#F8FAFC"
                                    TextColor="#0F172A"
                                    TitleColor="#64748B">
                                <Picker.Items>
                                    <x:String>Any</x:String>
                                    <x:String>With salary</x:String>
                                    <x:String>No salary specified</x:String>
                                </Picker.Items>
                            </Picker>

                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Row="1"
                                             Spacing="6">

                            <Label Text="Source"
                                   FontSize="13"
                                   FontAttributes="Bold"
                                   TextColor="#334155" />

                            <Picker x:Name="SourceFilterPicker"
                                    SelectedIndexChanged="OnFiltersChanged"
                                    BackgroundColor="#F8FAFC"
                                    TextColor="#0F172A"
                                    TitleColor="#64748B">
                                <Picker.Items>
                                    <x:String>All</x:String>
                                    <x:String>Adzuna</x:String>
                                </Picker.Items>
                            </Picker>

                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Row="1"
                                             Grid.Column="1"
                                             Spacing="6">

                            <Label Text="Sort"
                                   FontSize="13"
                                   FontAttributes="Bold"
                                   TextColor="#334155" />

                            <Picker x:Name="SortPicker"
                                    SelectedIndexChanged="OnFiltersChanged"
                                    BackgroundColor="#F8FAFC"
                                    TextColor="#0F172A"
                                    TitleColor="#64748B">
                                <Picker.Items>
                                    <x:String>Default</x:String>
                                    <x:String>Salary available first</x:String>
                                    <x:String>Company A-Z</x:String>
                                    <x:String>Title A-Z</x:String>
                                </Picker.Items>
                            </Picker>

                        </VerticalStackLayout>
                    </Grid>

                    <FlexLayout Direction="Row"
                                Wrap="Wrap"
                                JustifyContent="SpaceBetween"
                                AlignItems="Center">

                        <Button Text="Apply filters"
                                Clicked="OnApplyFiltersClicked"
                                BackgroundColor="#DCFCE7"
                                TextColor="#166534"
                                FontAttributes="Bold"
                                CornerRadius="16"
                                HeightRequest="48"
                                WidthRequest="155"
                                Margin="0,0,8,8" />

                        <Button Text="Reset filters"
                                Clicked="OnResetFiltersClicked"
                                BackgroundColor="#EFF6FF"
                                TextColor="#1D4ED8"
                                FontAttributes="Bold"
                                CornerRadius="16"
                                HeightRequest="48"
                                WidthRequest="155"
                                Margin="0,0,8,8" />

                    </FlexLayout>

                </VerticalStackLayout>
            </Border>

            <!-- Empty state -->
            <Border x:Name="EmptyJobsState"
                    BackgroundColor="White"
                    Stroke="#E2E8F0"
                    StrokeShape="RoundRectangle 24"
                    Padding="22"
                    IsVisible="True">

                <VerticalStackLayout Spacing="10"
                                     HorizontalOptions="Center">

                    <Label Text="No jobs loaded yet"
                           FontSize="20"
                           FontAttributes="Bold"
                           TextColor="#0F172A"
                           HorizontalTextAlignment="Center" />

                    <Label x:Name="EmptyJobsMessageLabel"
                           Text="Search for a role to see job offers here."
                           FontSize="14"
                           TextColor="#64748B"
                           HorizontalTextAlignment="Center"
                           LineBreakMode="WordWrap" />

                </VerticalStackLayout>
            </Border>

            <!-- Jobs list -->
            <CollectionView x:Name="JobsCollectionView"
                            SelectionMode="None"
                            IsVisible="False">

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border BackgroundColor="White"
                                Stroke="#E2E8F0"
                                StrokeShape="RoundRectangle 24"
                                Padding="18"
                                Margin="0,0,0,12">

                            <VerticalStackLayout Spacing="12">

                                <Grid ColumnDefinitions="*,Auto"
                                      ColumnSpacing="10">

                                    <VerticalStackLayout Spacing="4">

                                        <Label Text="{Binding Title}"
                                               FontSize="20"
                                               FontAttributes="Bold"
                                               TextColor="#0F172A"
                                               LineBreakMode="WordWrap" />

                                        <Label Text="{Binding Company}"
                                               FontSize="15"
                                               TextColor="#334155"
                                               LineBreakMode="WordWrap" />

                                        <Label Text="{Binding Location}"
                                               FontSize="13"
                                               TextColor="#64748B"
                                               LineBreakMode="WordWrap" />

                                    </VerticalStackLayout>

                                    <Border Grid.Column="1"
                                            BackgroundColor="#DBEAFE"
                                            Stroke="#BFDBFE"
                                            StrokeShape="RoundRectangle 14"
                                            Padding="10,6"
                                            VerticalOptions="Start">

                                        <Label Text="{Binding Source}"
                                               TextColor="#1D4ED8"
                                               FontAttributes="Bold"
                                               FontSize="12" />

                                    </Border>
                                </Grid>

                                <BoxView HeightRequest="1"
                                         BackgroundColor="#E2E8F0" />

                                <Grid ColumnDefinitions="*,*"
                                      ColumnSpacing="12">

                                    <VerticalStackLayout Spacing="4">

                                        <Label Text="Salary"
                                               FontSize="12"
                                               TextColor="#64748B" />

                                        <Label Text="{Binding Salary}"
                                               FontSize="14"
                                               FontAttributes="Bold"
                                               TextColor="#0F172A"
                                               LineBreakMode="WordWrap" />

                                    </VerticalStackLayout>

                                    <VerticalStackLayout Grid.Column="1"
                                                         Spacing="4">

                                        <Label Text="Posted"
                                               FontSize="12"
                                               TextColor="#64748B" />

                                        <Label Text="{Binding PostedText}"
                                               FontSize="14"
                                               FontAttributes="Bold"
                                               TextColor="#0F172A"
                                               LineBreakMode="TailTruncation" />

                                    </VerticalStackLayout>
                                </Grid>

                                <Label Text="{Binding Description}"
                                       FontSize="13"
                                       TextColor="#64748B"
                                       MaxLines="3"
                                       LineBreakMode="TailTruncation" />

                                <Button Text="View details"
                                          Loaded="OnTranslateLoadedElement"
                                        Clicked="OnViewJobDetailsClicked"
                                        CommandParameter="{Binding .}"
                                        BackgroundColor="#EFF6FF"
                                        TextColor="#1D4ED8"
                                        FontAttributes="Bold"
                                        CornerRadius="14"
                                        HeightRequest="46" />

                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Button x:Name="LoadMoreButton"
                    Text="Load more jobs"
                      Loaded="OnTranslateLoadedElement"
                    Clicked="OnLoadMoreClicked"
                    BackgroundColor="#DCFCE7"
                    TextColor="#166534"
                    FontAttributes="Bold"
                    CornerRadius="16"
                    HeightRequest="52"
                    IsVisible="False"
                    Margin="0,0,0,30" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="JobCv.Mobile.Pages.JobsPage"
             Shell.NavBarIsVisible="False"
            BackgroundColor="#F1F5F9">

    <ScrollView>
        <VerticalStackLayout Padding="24"
                             Spacing="20">

            <!-- Header -->
            <Grid ColumnDefinitions="Auto,*,Auto"
ColumnSpacing="14"
Margin="0,30,0,0">

                <Button Grid.Column="0"
      Text="☰"
      Clicked="OnMenuClicked"
      BackgroundColor="#E2E8F0"
      TextColor="#0F172A"
      CornerRadius="18"
      WidthRequest="48"
      HeightRequest="48"
      FontSize="22"
      VerticalOptions="Start" />
                <VerticalStackLayout Grid.Column="1"
                     Spacing="4">

                    <Label x:Name="PageTitleLabel"
       Text="Find Jobs"
       FontSize="34"
       FontAttributes="Bold"
       TextColor="#0F172A"
       MaxLines="1"
       LineBreakMode="NoWrap" />
                    <Label Text="Search job opportunities and create tailored CVs for each role."
           FontSize="16"
           TextColor="#64748B"
           LineBreakMode="WordWrap" />
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="2"
                   HorizontalOptions="End"
                   VerticalOptions="Start"
                   Spacing="8">

                    <Button Text="👤"
          Clicked="OnProfileClicked"
          BackgroundColor="#DCFCE7"
          TextColor="#0F172A"
          CornerRadius="22"
          WidthRequest="48"
          HeightRequest="48"
          FontSize="18" />

                    <Border x:Name="ProfileMenu"
          IsVisible="False"
          BackgroundColor="White"
          Stroke="#E2E8F0"
          StrokeShape="RoundRectangle 18"
          Padding="12"
          WidthRequest="210"
          Shadow="5,5,12,#22000000">

                        <VerticalStackLayout Spacing="8">

                            <Label Text="Profile"
                 FontSize="18"
                 FontAttributes="Bold"
                 TextColor="#0F172A"
                 Margin="4,0,4,6" />

                            <Button Text="View profile"
                  Clicked="OnViewProfileClicked"
                  BackgroundColor="#EFF6FF"
                  TextColor="#1D4ED8"
                  CornerRadius="12"
                  HeightRequest="44" />

                            <Button Text="Logout"
                  Clicked="OnLogoutClicked"
                  BackgroundColor="#FEE2E2"
                  TextColor="#DC2626"
                  CornerRadius="12"
                  HeightRequest="44" />

                        </VerticalStackLayout>
                    </Border>

                </VerticalStackLayout>
            </Grid>
            <!-- Hamburger menu -->
            <Border x:Name="MainMenu"
  IsVisible="False"
  BackgroundColor="White"
  Stroke="#E2E8F0"
  StrokeShape="RoundRectangle 22"
  Padding="14"
  Shadow="5,5,12,#22000000">

                <VerticalStackLayout Spacing="10">

                    <Label Text="Menu"
         FontSize="18"
         FontAttributes="Bold"
         TextColor="#0F172A"
         Margin="4,0,4,4" />
                    <Button Text="Dashboard"
        Clicked="OnDashboardClicked"
        BackgroundColor="#EFF6FF"
        TextColor="#1D4ED8"
        FontAttributes="Bold"
        CornerRadius="14"
        HeightRequest="46" />

                    <Button Text="My CVs"
        Clicked="OnMyCvsClicked"
        BackgroundColor="#EFF6FF"
        TextColor="#1D4ED8"
        FontAttributes="Bold"
        CornerRadius="14"
        HeightRequest="46" />

                    <Button Text="Applications"
        Clicked="OnMyApplicationsClicked"
         BackgroundColor="#EFF6FF"
  TextColor="#1D4ED8"
        FontAttributes="Bold"
        CornerRadius="14"
        HeightRequest="46" />

                    <Button Text="Jobs"
        Clicked="OnFindJobsClicked"
        BackgroundColor="#1D4ED8"
 TextColor="White"
        FontAttributes="Bold"
        CornerRadius="14"
        HeightRequest="46" />
                </VerticalStackLayout>
            </Border>
            <!-- Search box -->
            <Border BackgroundColor="White"
                    Stroke="#E2E8F0"
                    StrokeShape="RoundRectangle 26"
                    Padding="18">

                <VerticalStackLayout Spacing="12">

                    <Label Text="Search jobs"
                           FontSize="22"
                           FontAttributes="Bold"
                           TextColor="#0F172A" />

                    <Entry x:Name="QueryEntry"
                           Placeholder="Job title, keyword, skill"
                           BackgroundColor="#F8FAFC"
                           TextColor="#0F172A"
                           PlaceholderColor="#94A3B8" />

                    <Entry x:Name="LocationEntry"
                           Placeholder="Location, city or remote"
                           BackgroundColor="#F8FAFC"
                           TextColor="#0F172A"
                           PlaceholderColor="#94A3B8" />

                    <Button Text="Search"
                            Clicked="OnSearchClicked"
                            BackgroundColor="#1D4ED8"
                            TextColor="White"
                            FontAttributes="Bold"
                            CornerRadius="16"
                            HeightRequest="52" />

                    <Label x:Name="MessageLabel"
                           Text=""
                           FontSize="13"
                           TextColor="#64748B" />

                </VerticalStackLayout>
            </Border>

            <!-- Results title -->
            <VerticalStackLayout Spacing="4">
                <Label Text="Job results"
                       FontSize="24"
                       FontAttributes="Bold"
                       TextColor="#0F172A" />

                <Label Text="Tap View details to see the full description and all actions for a job."
                       FontSize="14"
                       TextColor="#64748B" />
            </VerticalStackLayout>

            <!-- Results -->
            <CollectionView x:Name="JobsCollectionView"
                            SelectionMode="None">

                <CollectionView.ItemTemplate>
                    <DataTemplate>

                        <Border BackgroundColor="#F0F7FF"
        Stroke="#BFDBFE"
                                   StrokeThickness="1"
        StrokeShape="RoundRectangle 24"
        Padding="18"
        Margin="0,0,0,14">


                            <VerticalStackLayout Spacing="10">

                                <Grid ColumnDefinitions="*,Auto"
                                      ColumnSpacing="12">

                                    <VerticalStackLayout Spacing="4">
                                        <Label Text="{Binding Title}"
                                               FontSize="22"
                                               FontAttributes="Bold"
                                               TextColor="#0F172A" />

                                        <Label Text="{Binding Company}"
                                               FontSize="15"
                                               TextColor="#334155" />

                                        <Label Text="{Binding Location}"
                                               FontSize="14"
                                               TextColor="#64748B" />
                                    </VerticalStackLayout>

                                    <Border Grid.Column="1"
        BackgroundColor="White"
        Stroke="#DBEAFE"
        StrokeShape="RoundRectangle 14"
        Padding="12">

                                        <Label Text="{Binding Source}"
                                               TextColor="#1D4ED8"
                                               FontSize="12"
                                               FontAttributes="Bold" />
                                    </Border>
                                </Grid>

                                <Label Text="{Binding Description}"
                                       FontSize="14"
                                       TextColor="#475569"
                                       LineBreakMode="WordWrap" />

                                <Grid ColumnDefinitions="*,*"
                                      ColumnSpacing="10">

                                    <Border BackgroundColor="White"
        Stroke="#DBEAFE"
        StrokeShape="RoundRectangle 14"
        Padding="12">
                                        <VerticalStackLayout Spacing="3">
                                            <Label Text="Salary"
                                                   FontSize="12"
                                                   TextColor="#64748B" />

                                            <Label Text="{Binding Salary}"
                                                   FontSize="14"
                                                   TextColor="#0F172A"
                                                   FontAttributes="Bold" />
                                        </VerticalStackLayout>
                                    </Border>

                                    <Border Grid.Column="1"
        BackgroundColor="White"
        Stroke="#DBEAFE"
        StrokeShape="RoundRectangle 14"
        Padding="12">

                                        <VerticalStackLayout Spacing="3">
                                            <Label Text="Posted"
                                                   FontSize="12"
                                                   TextColor="#64748B" />

                                            <Label Text="{Binding PostedText}"
                                                   FontSize="14"
                                                   TextColor="#0F172A"
                                                   FontAttributes="Bold" />
                                        </VerticalStackLayout>
                                    </Border>
                                </Grid>
                                <Button Text="View details"
                                        Clicked="OnViewJobDetailsClicked"
                                        CommandParameter="{Binding .}"
                                        BackgroundColor="#1D4ED8"
                                        TextColor="White"
                                        FontAttributes="Bold"
                                        FontSize="15"
                                        CornerRadius="16"
                                        HeightRequest="54"
                                        Margin="0,14,0,0" />

                            </VerticalStackLayout>
                        </Border>

                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
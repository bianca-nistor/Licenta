<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="JobCv.Mobile.Pages.ProfilePage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#F1F5F9">

    <ScrollView>
        <VerticalStackLayout Padding="24"
                             Spacing="20">

            <!-- Header -->
            <Grid ColumnDefinitions="Auto,*"
                  ColumnSpacing="14"
                  Margin="0,30,0,0">

                <Button Text="←"
                        Clicked="OnBackClicked"
                        BackgroundColor="#E2E8F0"
                        TextColor="#0F172A"
                        CornerRadius="18"
                        WidthRequest="48"
                        HeightRequest="48"
                        FontSize="20" />

                <VerticalStackLayout Grid.Column="1"
                                     Spacing="4">

                    <Label Text="Profile"
                           FontSize="34"
                           FontAttributes="Bold"
                           TextColor="#0F172A"
                           LineBreakMode="WordWrap" />

                    <Label Text="View your account information and access your main sections."
                           FontSize="15"
                           TextColor="#64748B"
                           LineBreakMode="WordWrap" />

                </VerticalStackLayout>
            </Grid>

            <!-- Profile card -->
            <Border BackgroundColor="White"
                    Stroke="#E2E8F0"
                    StrokeShape="RoundRectangle 28"
                    Padding="24">

                <VerticalStackLayout Spacing="18">

                    <Grid ColumnDefinitions="Auto,*"
                          ColumnSpacing="16">

                        <Border BackgroundColor="#DBEAFE"
                                Stroke="#BFDBFE"
                                StrokeShape="RoundRectangle 30"
                                WidthRequest="72"
                                HeightRequest="72"
                                Padding="0"
                                VerticalOptions="Start">

                            <Label x:Name="InitialsLabel"
                                   Text="U"
                                   FontSize="28"
                                   FontAttributes="Bold"
                                   TextColor="#1D4ED8"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />

                        </Border>

                        <VerticalStackLayout Grid.Column="1"
                                             Spacing="5"
                                             VerticalOptions="Center">

                            <Label x:Name="FullNameLabel"
                                   FontSize="24"
                                   FontAttributes="Bold"
                                   TextColor="#0F172A"
                                   LineBreakMode="WordWrap" />

                            <Label x:Name="EmailLabel"
                                   FontSize="15"
                                   TextColor="#64748B"
                                   LineBreakMode="WordWrap" />

                            <Border BackgroundColor="#EFF6FF"
                                    Stroke="#BFDBFE"
                                    StrokeShape="RoundRectangle 14"
                                    Padding="10,6"
                                    HorizontalOptions="Start"
                                    Margin="0,4,0,0">

                                <Label Text="JobCv user"
                                       FontSize="12"
                                       FontAttributes="Bold"
                                       TextColor="#1D4ED8" />

                            </Border>
                        </VerticalStackLayout>
                    </Grid>

                    <BoxView HeightRequest="1"
                             Color="#E2E8F0" />

                    <Grid ColumnDefinitions="*,*"
                          ColumnSpacing="12">

                        <Border BackgroundColor="#F8FAFC"
                                Stroke="#E2E8F0"
                                StrokeShape="RoundRectangle 18"
                                Padding="14">

                            <VerticalStackLayout Spacing="4">
                                <Label Text="Account"
                                       FontSize="12"
                                       TextColor="#64748B" />

                                <Label Text="Personal"
                                       FontSize="16"
                                       FontAttributes="Bold"
                                       TextColor="#0F172A" />
                            </VerticalStackLayout>
                        </Border>

                        <Border Grid.Column="1"
                                BackgroundColor="#F8FAFC"
                                Stroke="#E2E8F0"
                                StrokeShape="RoundRectangle 18"
                                Padding="14">

                            <VerticalStackLayout Spacing="4">
                                <Label Text="Status"
                                       FontSize="12"
                                       TextColor="#64748B" />

                                <Label Text="Active"
                                       FontSize="16"
                                       FontAttributes="Bold"
                                       TextColor="#166534" />
                            </VerticalStackLayout>
                        </Border>
                    </Grid>

                </VerticalStackLayout>
            </Border>

            <!-- Quick actions -->
            <Border BackgroundColor="White"
                    Stroke="#E2E8F0"
                    StrokeShape="RoundRectangle 28"
                    Padding="22">

                <VerticalStackLayout Spacing="14">

                    <Label Text="Quick actions"
                           FontSize="23"
                           FontAttributes="Bold"
                           TextColor="#0F172A" />

                    <Label Text="Go directly to the most important sections of your career workspace."
                           FontSize="14"
                           TextColor="#64748B"
                           LineBreakMode="WordWrap" />

                    <FlexLayout Direction="Row"
                                Wrap="Wrap"
                                JustifyContent="SpaceBetween"
                                AlignItems="Center"
                                Margin="0,4,0,0">

                        <Button Text="Dashboard"
                                Clicked="OnDashboardClicked"
                                BackgroundColor="#1D4ED8"
                                TextColor="White"
                                FontAttributes="Bold"
                                CornerRadius="16"
                                HeightRequest="52"
                                WidthRequest="155"
                                Margin="0,0,8,12" />

                        <Button Text="My CVs"
                                Clicked="OnMyCvsClicked"
                                BackgroundColor="#2563EB"
                                TextColor="White"
                                FontAttributes="Bold"
                                CornerRadius="16"
                                HeightRequest="52"
                                WidthRequest="155"
                                Margin="0,0,8,12" />

                        <Button Text="Applications"
                                Clicked="OnApplicationsClicked"
                                BackgroundColor="#EFF6FF"
                                TextColor="#1D4ED8"
                                FontAttributes="Bold"
                                CornerRadius="16"
                                HeightRequest="52"
                                WidthRequest="155"
                                Margin="0,0,8,12" />

                        <Button Text="Jobs"
                                Clicked="OnJobsClicked"
                                BackgroundColor="#DCFCE7"
                                TextColor="#166534"
                                FontAttributes="Bold"
                                CornerRadius="16"
                                HeightRequest="52"
                                WidthRequest="155"
                                Margin="0,0,8,12" />

                    </FlexLayout>

                </VerticalStackLayout>
            </Border>

            <!-- Logout -->
            <Border BackgroundColor="White"
                    Stroke="#E2E8F0"
                    StrokeShape="RoundRectangle 28"
                    Padding="22"
                    Margin="0,0,0,30">

                <VerticalStackLayout Spacing="14">

                    <Label Text="Session"
                           FontSize="23"
                           FontAttributes="Bold"
                           TextColor="#0F172A" />

                    <Label Text="You can safely log out from your account."
                           FontSize="14"
                           TextColor="#64748B"
                           LineBreakMode="WordWrap" />

                    <Button Text="Logout"
                            Clicked="OnLogoutClicked"
                            BackgroundColor="#FEE2E2"
                            TextColor="#DC2626"
                            FontAttributes="Bold"
                            CornerRadius="16"
                            HeightRequest="52" />

                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
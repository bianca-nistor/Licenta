<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="JobCv.Mobile.Pages.ChangePasswordPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#F1F5F9">

    <ScrollView>
        <VerticalStackLayout Padding="24"
                             Spacing="20">

            <Grid ColumnDefinitions="*"
                  ColumnSpacing="14"
                  Margin="0,30,0,0">


                <VerticalStackLayout Grid.Column="0"
                                     Spacing="4">

                    <Label Text="Change Password"
                           FontSize="34"
                           FontAttributes="Bold"
                           TextColor="#0F172A"
                           LineBreakMode="WordWrap" />

                    <Label Text="Update your password securely."
                           FontSize="15"
                           TextColor="#64748B"
                           LineBreakMode="WordWrap" />

                </VerticalStackLayout>
            </Grid>

            <Border BackgroundColor="White"
                    Stroke="#E2E8F0"
                    StrokeShape="RoundRectangle 28"
                    Padding="22">

                <VerticalStackLayout Spacing="16">

                    <Label Text="Password details"
                           FontSize="23"
                           FontAttributes="Bold"
                           TextColor="#0F172A" />

                    <Label Text="Current password"
                           FontSize="13"
                           FontAttributes="Bold"
                           TextColor="#334155" />

                    <Entry x:Name="CurrentPasswordEntry"
                           Placeholder="Enter current password"
                           IsPassword="True"
                           BackgroundColor="#F8FAFC"
                           TextColor="#0F172A"
                           PlaceholderColor="#94A3B8" />

                    <Label Text="New password"
                           FontSize="13"
                           FontAttributes="Bold"
                           TextColor="#334155" />

                    <Entry x:Name="NewPasswordEntry"
                           Placeholder="Enter new password"
                           IsPassword="True"
                           BackgroundColor="#F8FAFC"
                           TextColor="#0F172A"
                           PlaceholderColor="#94A3B8" />

                    <Label Text="Confirm new password"
                           FontSize="13"
                           FontAttributes="Bold"
                           TextColor="#334155" />

                    <Entry x:Name="ConfirmNewPasswordEntry"
                           Placeholder="Confirm new password"
                           IsPassword="True"
                           BackgroundColor="#F8FAFC"
                           TextColor="#0F172A"
                           PlaceholderColor="#94A3B8" />

                    <Label Text="Password must have at least 6 characters."
                           FontSize="13"
                           TextColor="#64748B"
                           LineBreakMode="WordWrap" />

                </VerticalStackLayout>
            </Border>

            <Label x:Name="MessageLabel"
                   Text=""
                   FontSize="13"
                   TextColor="#DC2626"
                   LineBreakMode="WordWrap" />

            <Button Text="Save new password"
                    Clicked="OnSaveClicked"
                    BackgroundColor="#1D4ED8"
                    TextColor="White"
                    FontAttributes="Bold"
                    CornerRadius="16"
                    HeightRequest="54" />

            <Button Text="Cancel"
                    Clicked="OnBackClicked"
                    BackgroundColor="#E2E8F0"
                    TextColor="#0F172A"
                    FontAttributes="Bold"
                    CornerRadius="16"
                    HeightRequest="52"
                    Margin="0,0,0,30" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
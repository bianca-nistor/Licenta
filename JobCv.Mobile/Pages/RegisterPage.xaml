<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="JobCv.Mobile.Pages.RegisterPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#F8FAFC">

    <ScrollView>
        <Grid Padding="24,14,24,24"
              RowDefinitions="Auto,*">

            <VerticalStackLayout Grid.Row="0"
                                 Spacing="8"
                                 Margin="0,8,0,18"
                                 HorizontalOptions="Center"
                                 MaximumWidthRequest="520">

                <Label Text="Creează cont"
                       FontSize="32"
                       FontAttributes="Bold"
                       TextColor="#0F172A"
                       HorizontalTextAlignment="Center" />

                <Label Text="Începe să-ți construiești profilul profesional."
                       FontSize="15"
                       TextColor="#64748B"
                       HorizontalTextAlignment="Center"
                       LineBreakMode="WordWrap" />

            </VerticalStackLayout>

            <Border Grid.Row="1"
                    BackgroundColor="White"
                    Stroke="#E2E8F0"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 30"
                    Padding="24"
                    HorizontalOptions="Center"
                    MaximumWidthRequest="520">

                <VerticalStackLayout Spacing="16">

                    <VerticalStackLayout Spacing="4">
                        <Label Text="Alătură-te Career Guide"
                               FontSize="22"
                               FontAttributes="Bold"
                               TextColor="#0F172A"
                               LineBreakMode="WordWrap" />

                        <Label Text="Creează-ți contul și gestionează CV-urile, joburile și aplicațiile."
                               FontSize="14"
                               TextColor="#64748B"
                               LineBreakMode="WordWrap" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="6">
                        <Label Text="Nume complet"
                               FontSize="14"
                               FontAttributes="Bold"
                               TextColor="#0F172A" />

                        <Entry x:Name="FullNameEntry"
                               Placeholder="Introdu numele complet"
                               TextColor="#0F172A"
                               PlaceholderColor="#94A3B8"
                               BackgroundColor="#F8FAFC"
                               HeightRequest="50" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="6">
                        <Label Text="Email"
                               FontSize="14"
                               FontAttributes="Bold"
                               TextColor="#0F172A" />

                        <Entry x:Name="EmailEntry"
                               Placeholder="Introdu emailul"
                               Keyboard="Email"
                               TextColor="#0F172A"
                               PlaceholderColor="#94A3B8"
                               BackgroundColor="#F8FAFC"
                               HeightRequest="50" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="6">
                        <Label Text="Parolă"
                               FontSize="14"
                               FontAttributes="Bold"
                               TextColor="#0F172A" />

                        <Entry x:Name="PasswordEntry"
                               Placeholder="Creează o parolă"
                               IsPassword="True"
                               TextColor="#0F172A"
                               PlaceholderColor="#94A3B8"
                               BackgroundColor="#F8FAFC"
                               HeightRequest="50" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="6">
                        <Label Text="Confirmă parola"
                               FontSize="14"
                               FontAttributes="Bold"
                               TextColor="#0F172A" />

                        <Entry x:Name="ConfirmPasswordEntry"
                               Placeholder="Confirmă parola"
                               IsPassword="True"
                               TextColor="#0F172A"
                               PlaceholderColor="#94A3B8"
                               BackgroundColor="#F8FAFC"
                               HeightRequest="50" />
                    </VerticalStackLayout>

                    <Label x:Name="MessageLabel"
                           Text=""
                           TextColor="#DC2626"
                           FontSize="13"
                           HorizontalTextAlignment="Center" />

                    <Button Text="Creează cont"
                            Clicked="OnRegisterClicked"
                            BackgroundColor="#1D4ED8"
                            TextColor="White"
                            FontAttributes="Bold"
                            CornerRadius="16"
                            HeightRequest="52" />

                    <Button Text="Înapoi la autentificare"
                            Clicked="OnBackToLoginClicked"
                            BackgroundColor="#DCFCE7"
                            TextColor="#166534"
                            FontAttributes="Bold"
                            CornerRadius="16"
                            HeightRequest="52" />

                </VerticalStackLayout>
            </Border>

        </Grid>
    </ScrollView>
</ContentPage>
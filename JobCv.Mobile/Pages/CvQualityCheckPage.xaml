<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="JobCv.Mobile.Pages.CvQualityCheckPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#F1F5F9">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="18">

            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14" Margin="0,30,0,0">
                <Button Text="←"
                        Clicked="OnBackClicked"
                        BackgroundColor="#E2E8F0"
                        TextColor="#0F172A"
                        CornerRadius="18"
                        WidthRequest="48"
                        HeightRequest="48"
                        FontSize="22" />

                <VerticalStackLayout Grid.Column="1" Spacing="4">
                    <Label Text="CV Quality Check"
                           FontSize="32"
                           FontAttributes="Bold"
                           TextColor="#0F172A" />
                    <Label x:Name="SubtitleLabel"
                           Text="Check how complete and professional this CV is."
                           FontSize="15"
                           TextColor="#64748B"
                           LineBreakMode="WordWrap" />
                </VerticalStackLayout>
            </Grid>

            <Border BackgroundColor="White"
                    Stroke="#E2E8F0"
                    StrokeShape="RoundRectangle 26"
                    Padding="22">
                <VerticalStackLayout Spacing="16">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="18">
                        <Border WidthRequest="92"
                                HeightRequest="92"
                                BackgroundColor="#EFF6FF"
                                Stroke="#BFDBFE"
                                StrokeShape="RoundRectangle 46"
                                Padding="8">
                            <Label x:Name="ScoreLabel"
                                   Text="--%"
                                   FontSize="26"
                                   FontAttributes="Bold"
                                   TextColor="#1D4ED8"
                                   HorizontalTextAlignment="Center"
                                   VerticalTextAlignment="Center" />
                        </Border>

                        <VerticalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="Center">
                            <Label x:Name="LevelLabel"
                                   Text="Not checked yet"
                                   FontSize="22"
                                   FontAttributes="Bold"
                                   TextColor="#0F172A" />
                            <Label x:Name="SummaryLabel"
                                   Text="Press the button below to analyze the selected CV."
                                   FontSize="14"
                                   TextColor="#64748B"
                                   LineBreakMode="WordWrap" />
                        </VerticalStackLayout>
                    </Grid>

                    <Button x:Name="CheckButton"
                            Text="Check CV quality"
                            Clicked="OnCheckCvQualityClicked"
                            BackgroundColor="#1D4ED8"
                            TextColor="White"
                            FontAttributes="Bold"
                            CornerRadius="16"
                            HeightRequest="52" />

                    <ActivityIndicator x:Name="LoadingIndicator"
                                       IsRunning="False"
                                       IsVisible="False" />

                    <Label x:Name="MessageLabel"
                           Text=""
                           FontSize="14"
                           TextColor="#DC2626" />
                </VerticalStackLayout>
            </Border>

            <Border BackgroundColor="White"
                    Stroke="#E2E8F0"
                    StrokeShape="RoundRectangle 24"
                    Padding="18">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Strengths"
                           FontSize="20"
                           FontAttributes="Bold"
                           TextColor="#0F172A" />

                    <CollectionView x:Name="StrengthsCollectionView"
                                    SelectionMode="None">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border BackgroundColor="#DCFCE7"
                                        Stroke="#BBF7D0"
                                        StrokeShape="RoundRectangle 14"
                                        Padding="12"
                                        Margin="0,0,0,8">
                                    <Label Text="{Binding .}"
                                           FontSize="14"
                                           TextColor="#166534"
                                           LineBreakMode="WordWrap" />
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Border>

            <Border BackgroundColor="White"
                    Stroke="#E2E8F0"
                    StrokeShape="RoundRectangle 24"
                    Padding="18">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Problems found"
                           FontSize="20"
                           FontAttributes="Bold"
                           TextColor="#0F172A" />

                    <CollectionView x:Name="IssuesCollectionView"
                                    SelectionMode="None">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border BackgroundColor="#FFF7ED"
                                        Stroke="#FED7AA"
                                        StrokeShape="RoundRectangle 16"
                                        Padding="14"
                                        Margin="0,0,0,10">
                                    <VerticalStackLayout Spacing="5">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <Label Text="{Binding Section}"
                                                   FontSize="16"
                                                   FontAttributes="Bold"
                                                   TextColor="#9A3412" />

                                            <Border Grid.Column="1"
                                                    BackgroundColor="#FFEDD5"
                                                    Stroke="#FDBA74"
                                                    StrokeShape="RoundRectangle 10"
                                                    Padding="8,3">
                                                <Label Text="{Binding Severity}"
                                                       FontSize="11"
                                                       FontAttributes="Bold"
                                                       TextColor="#9A3412" />
                                            </Border>
                                        </Grid>

                                        <Label Text="{Binding Problem}"
                                               FontSize="14"
                                               TextColor="#7C2D12"
                                               LineBreakMode="WordWrap" />

                                        <Label Text="{Binding Suggestion}"
                                               FontSize="13"
                                               TextColor="#64748B"
                                               LineBreakMode="WordWrap" />
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Border>

            <Border BackgroundColor="White"
                    Stroke="#E2E8F0"
                    StrokeShape="RoundRectangle 24"
                    Padding="18"
                    Margin="0,0,0,30">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Recommendations"
                           FontSize="20"
                           FontAttributes="Bold"
                           TextColor="#0F172A" />

                    <CollectionView x:Name="SuggestionsCollectionView"
                                    SelectionMode="None">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border BackgroundColor="#EFF6FF"
                                        Stroke="#BFDBFE"
                                        StrokeShape="RoundRectangle 14"
                                        Padding="12"
                                        Margin="0,0,0,8">
                                    <Label Text="{Binding .}"
                                           FontSize="14"
                                           TextColor="#1D4ED8"
                                           LineBreakMode="WordWrap" />
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>

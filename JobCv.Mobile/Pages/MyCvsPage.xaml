<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="JobCv.Mobile.Pages.MyCvsPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#F1F5F9">

    <ScrollView>
        <VerticalStackLayout Padding="18"
                             Spacing="20">

            <!-- Header -->
            <Grid ColumnDefinitions="Auto,*,Auto"
                  ColumnSpacing="10"
                  Margin="0,26,0,0">

                <Button Grid.Column="0"
                        Text="☰"
                        Clicked="OnMenuClicked"
                        BackgroundColor="#E2E8F0"
                        TextColor="#0F172A"
                        CornerRadius="18"
                        WidthRequest="44"
                        HeightRequest="44"
                        FontSize="20"
                        VerticalOptions="Start" />

                <VerticalStackLayout Grid.Column="1"
                                     Spacing="4"
                                     VerticalOptions="Start">

                    <Label x:Name="PageTitleLabel"
                           Text="My CVs"
                           FontSize="28"
                           FontAttributes="Bold"
                           TextColor="#0F172A"
                           MaxLines="2"
                           LineBreakMode="WordWrap" />

                    <Label Text="View, edit, preview and manage all your created and uploaded CVs."
                           FontSize="15"
                           TextColor="#64748B"
                           LineBreakMode="WordWrap" />

                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="2"
                                     HorizontalOptions="End"
                                     VerticalOptions="Start"
                                     Spacing="8">

                    <Button Text="👤"
                            Clicked="OnProfileClicked"
                            BackgroundColor="#DCFCE7"
                            TextColor="#0F172A"
                            CornerRadius="22"
                            WidthRequest="48"
                            HeightRequest="48"
                            FontSize="18" />

                    <Border x:Name="ProfileMenu"
                            IsVisible="False"
                            BackgroundColor="White"
                            Stroke="#E2E8F0"
                            StrokeShape="RoundRectangle 18"
                            Padding="12"
                            WidthRequest="210"
                            Shadow="5,5,12,#22000000">

                        <VerticalStackLayout Spacing="8">

                            <Label Text="Profile"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   TextColor="#0F172A"
                                   Margin="4,0,4,6" />

                            <Button Text="View profile"
                                    Clicked="OnViewProfileClicked"
                                    BackgroundColor="#EFF6FF"
                                    TextColor="#1D4ED8"
                                    CornerRadius="12"
                                    HeightRequest="44" />

                            <Button Text="Logout"
                                    Clicked="OnLogoutClicked"
                                    BackgroundColor="#FEE2E2"
                                    TextColor="#DC2626"
                                    CornerRadius="12"
                                    HeightRequest="44" />

                        </VerticalStackLayout>
                    </Border>

                </VerticalStackLayout>
            </Grid>

            <!-- Hamburger menu -->
            <Border x:Name="MainMenu"
                    IsVisible="False"
                    BackgroundColor="White"
                    Stroke="#E2E8F0"
                    StrokeShape="RoundRectangle 22"
                    Padding="14"
                    Shadow="5,5,12,#22000000">

                <VerticalStackLayout Spacing="10">

                    <Label Text="Menu"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="#0F172A"
                           Margin="4,0,4,4" />

                    <Button Text="Dashboard"
                            Clicked="OnDashboardClicked"
                            BackgroundColor="#EFF6FF"
                            TextColor="#1D4ED8"
                            FontAttributes="Bold"
                            CornerRadius="14"
                            HeightRequest="46" />

                    <Button Text="My CVs"
                            Clicked="OnMyCvsClicked"
                            BackgroundColor="#1D4ED8"
                            TextColor="White"
                            FontAttributes="Bold"
                            CornerRadius="14"
                            HeightRequest="46" />

                    <Button Text="Applications"
                            Clicked="OnMyApplicationsClicked"
                            BackgroundColor="#EFF6FF"
                            TextColor="#1D4ED8"
                            FontAttributes="Bold"
                            CornerRadius="14"
                            HeightRequest="46" />

                    <Button Text="Jobs"
                            Clicked="OnFindJobsClicked"
                            BackgroundColor="#EFF6FF"
                            TextColor="#1D4ED8"
                            FontAttributes="Bold"
                            CornerRadius="14"
                            HeightRequest="46" />

                </VerticalStackLayout>
            </Border>

            <!-- CV organization tools -->
            <Border BackgroundColor="White"
                    Stroke="#E2E8F0"
                    StrokeShape="RoundRectangle 24"
                    Padding="16">

                <VerticalStackLayout Spacing="12">

                    <Label Text="Organize CVs"
                           FontSize="20"
                           FontAttributes="Bold"
                           TextColor="#0F172A" />

                    <SearchBar x:Name="CvSearchBar"
                               Placeholder="Search CV by title"
                               TextChanged="OnCvSearchTextChanged"
                               BackgroundColor="#F8FAFC"
                               TextColor="#0F172A"
                               PlaceholderColor="#94A3B8" />

                    <Grid ColumnDefinitions="*,*"
                          ColumnSpacing="10">

                        <Picker x:Name="CvTypeFilterPicker"
                                Title="Filter"
                                SelectedIndexChanged="OnCvFilterChanged"
                                BackgroundColor="#F8FAFC"
                                TextColor="#0F172A">
                            <Picker.Items>
                                <x:String>All</x:String>
                                <x:String>Created</x:String>
                                <x:String>Uploaded</x:String>
                            </Picker.Items>
                        </Picker>

                        <Picker x:Name="CvSortPicker"
                                Grid.Column="1"
                                Title="Sort"
                                SelectedIndexChanged="OnCvSortChanged"
                                BackgroundColor="#F8FAFC"
                                TextColor="#0F172A">
                            <Picker.Items>
                                <x:String>Newest</x:String>
                                <x:String>Oldest</x:String>
                                <x:String>A-Z</x:String>
                            </Picker.Items>
                        </Picker>

                    </Grid>

                </VerticalStackLayout>
            </Border>

            <!-- Created CVs header -->
            <VerticalStackLayout x:Name="CreatedCvsSectionHeader"
                                 Spacing="8"
                                 Margin="0,8,0,0">

                <Label Text="Created CVs"
                       FontSize="24"
                       FontAttributes="Bold"
                       TextColor="#0F172A" />

                <Label Text="CVs built and edited inside the application."
                       FontSize="14"
                       TextColor="#64748B"
                       LineBreakMode="WordWrap" />

            </VerticalStackLayout>

            <!-- Empty created CVs -->
            <Border x:Name="EmptyCreatedCvsState"
                    BackgroundColor="White"
                    Stroke="#E2E8F0"
                    StrokeShape="RoundRectangle 24"
                    Padding="20"
                    IsVisible="False">

                <VerticalStackLayout Spacing="10"
                                     HorizontalOptions="Center">

                    <Label Text="No created CVs yet"
                           FontSize="20"
                           FontAttributes="Bold"
                           TextColor="#0F172A"
                           HorizontalTextAlignment="Center"
                           LineBreakMode="WordWrap" />

                    <Label Text="Create your first structured CV to edit sections and export it later."
                           FontSize="14"
                           TextColor="#64748B"
                           HorizontalTextAlignment="Center"
                           LineBreakMode="WordWrap" />

                    <Button Text="Create your first CV"
                            Clicked="OnCreateCvClicked"
                            BackgroundColor="#DCFCE7"
                            TextColor="#166534"
                            FontAttributes="Bold"
                            CornerRadius="16"
                            WidthRequest="220"
                            HeightRequest="48" />

                </VerticalStackLayout>
            </Border>

            <!-- Created CVs list -->
            <CollectionView x:Name="CvsCollectionView"
                            SelectionMode="None">

                <CollectionView.ItemTemplate>
                    <DataTemplate>

                        <Border BackgroundColor="White"
                                Stroke="#E2E8F0"
                                StrokeShape="RoundRectangle 24"
                                Padding="18"
                                Margin="0,0,0,12">

                            <VerticalStackLayout Spacing="14">

                                <!-- CV info -->
                                <VerticalStackLayout Spacing="8">

                                    <Grid ColumnDefinitions="*,Auto"
                                          ColumnSpacing="10">

                                        <VerticalStackLayout Spacing="4">

                                            <Label Text="{Binding Title}"
                                                   FontSize="20"
                                                   FontAttributes="Bold"
                                                   TextColor="#0F172A"
                                                   LineBreakMode="WordWrap" />

                                            <Label Text="{Binding Summary}"
                                                   FontSize="13"
                                                   TextColor="#64748B"
                                                   LineBreakMode="WordWrap"
                                                   MaxLines="3" />

                                        </VerticalStackLayout>

                                        <Border Grid.Column="1"
                                                BackgroundColor="#DBEAFE"
                                                Stroke="#BFDBFE"
                                                StrokeShape="RoundRectangle 14"
                                                Padding="10,6"
                                                VerticalOptions="Start">

                                            <Label Text="{Binding LanguageDisplay}"
                                                   TextColor="#1D4ED8"
                                                   FontAttributes="Bold"
                                                   FontSize="12" />

                                        </Border>
                                    </Grid>

                                </VerticalStackLayout>

                                <BoxView HeightRequest="1"
                                         BackgroundColor="#E2E8F0" />

                                <!-- Actions -->
                                <Grid ColumnDefinitions="*,*"
                                      RowDefinitions="Auto,Auto"
                                      ColumnSpacing="10"
                                      RowSpacing="10">

                                    <Button Grid.Row="0"
                                            Grid.Column="0"
                                            Text="Details"
                                            Clicked="OnViewDetailsClicked"
                                            CommandParameter="{Binding Id}"
                                            BackgroundColor="#EEF4FF"
                                            TextColor="#1D4ED8"
                                            FontAttributes="Bold"
                                            CornerRadius="14"
                                            HeightRequest="46" />

                                    <Button Grid.Row="0"
                                            Grid.Column="1"
                                            Text="Preview"
                                            Clicked="OnPreviewCvPdfClicked"
                                            CommandParameter="{Binding .}"
                                            BackgroundColor="#DCFCE7"
                                            TextColor="#166534"
                                            FontAttributes="Bold"
                                            CornerRadius="14"
                                            HeightRequest="46" />

                                    <Button Grid.Row="1"
                                            Grid.Column="0"
                                            Text="Quality"
                                            Clicked="OnCheckCvQualityClicked"
                                            CommandParameter="{Binding Id}"
                                            BackgroundColor="#FEF3C7"
                                            TextColor="#92400E"
                                            FontAttributes="Bold"
                                            CornerRadius="14"
                                            HeightRequest="46" />

                                    <Button Grid.Row="1"
                                            Grid.Column="1"
                                            Text="Delete"
                                            Clicked="OnDeleteCvClicked"
                                            CommandParameter="{Binding Id}"
                                            BackgroundColor="#FEE2E2"
                                            TextColor="#DC2626"
                                            FontAttributes="Bold"
                                            CornerRadius="14"
                                            HeightRequest="46" />

                                </Grid>

                            </VerticalStackLayout>
                        </Border>

                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Button x:Name="CreateAnotherCvButton"
                    Text="Create another CV"
                    Clicked="OnCreateCvClicked"
                    BackgroundColor="#DCFCE7"
                    TextColor="#166534"
                    FontAttributes="Bold"
                    CornerRadius="16"
                    HeightRequest="52"
                    Margin="0,0,0,8" />

            <!-- Uploaded CVs header -->
            <VerticalStackLayout x:Name="UploadedCvsSectionHeader"
                                 Spacing="8"
                                 Margin="0,8,0,0">

                <Label Text="Uploaded CVs"
                       FontSize="24"
                       FontAttributes="Bold"
                       TextColor="#0F172A" />

                <Label Text="Files uploaded by you. These can be used later when applying to jobs."
                       FontSize="14"
                       TextColor="#64748B"
                       LineBreakMode="WordWrap" />

            </VerticalStackLayout>

            <!-- Empty uploaded CVs -->
            <Border x:Name="EmptyUploadedCvsState"
                    BackgroundColor="White"
                    Stroke="#E2E8F0"
                    StrokeShape="RoundRectangle 24"
                    Padding="20"
                    IsVisible="False">

                <VerticalStackLayout Spacing="10"
                                     HorizontalOptions="Center">

                    <Label Text="No uploaded CVs yet"
                           FontSize="20"
                           FontAttributes="Bold"
                           TextColor="#0F172A"
                           HorizontalTextAlignment="Center"
                           LineBreakMode="WordWrap" />

                    <Label Text="Upload an existing PDF, DOC or DOCX CV."
                           FontSize="14"
                           TextColor="#64748B"
                           HorizontalTextAlignment="Center"
                           LineBreakMode="WordWrap" />

                    <Button Text="Upload CV"
                            Clicked="OnUploadCvClicked"
                            BackgroundColor="#DCFCE7"
                            TextColor="#166534"
                            FontAttributes="Bold"
                            CornerRadius="16"
                            WidthRequest="180"
                            HeightRequest="48" />

                </VerticalStackLayout>
            </Border>

            <!-- Uploaded CVs list -->
            <CollectionView x:Name="UploadedCvsCollectionView"
                            SelectionMode="None">

                <CollectionView.ItemTemplate>
                    <DataTemplate>

                        <Border BackgroundColor="White"
                                Stroke="#E2E8F0"
                                StrokeShape="RoundRectangle 24"
                                Padding="18"
                                Margin="0,0,0,12">

                            <VerticalStackLayout Spacing="14">

                                <VerticalStackLayout Spacing="8">

                                    <Grid ColumnDefinitions="*,Auto"
                                          ColumnSpacing="10">

                                        <VerticalStackLayout Spacing="4">

                                            <Label Text="{Binding OriginalFileName}"
                                                   FontSize="20"
                                                   FontAttributes="Bold"
                                                   TextColor="#0F172A"
                                                   LineBreakMode="WordWrap" />

                                            <Label Text="{Binding DisplaySize}"
                                                   FontSize="13"
                                                   TextColor="#64748B"
                                                   LineBreakMode="WordWrap" />

                                        </VerticalStackLayout>

                                        <Border Grid.Column="1"
                                                BackgroundColor="#DCFCE7"
                                                Stroke="#BBF7D0"
                                                StrokeShape="RoundRectangle 14"
                                                Padding="10,6"
                                                VerticalOptions="Start">

                                            <Label Text="uploaded"
                                                   TextColor="#166534"
                                                   FontAttributes="Bold"
                                                   FontSize="12" />

                                        </Border>
                                    </Grid>

                                </VerticalStackLayout>

                                <BoxView HeightRequest="1"
                                         BackgroundColor="#E2E8F0" />

                                <Grid ColumnDefinitions="*,*"
                                      ColumnSpacing="10">

                                    <Button Grid.Column="0"
                                            Text="Open file"
                                            Clicked="OnOpenUploadedCvClicked"
                                            CommandParameter="{Binding .}"
                                            BackgroundColor="#EFF6FF"
                                            TextColor="#1D4ED8"
                                            FontAttributes="Bold"
                                            CornerRadius="14"
                                            HeightRequest="46" />

                                    <Button Grid.Column="1"
                                            Text="Delete"
                                            Clicked="OnDeleteUploadedCvClicked"
                                            CommandParameter="{Binding Id}"
                                            BackgroundColor="#FEE2E2"
                                            TextColor="#DC2626"
                                            FontAttributes="Bold"
                                            CornerRadius="14"
                                            HeightRequest="46" />

                                </Grid>

                            </VerticalStackLayout>
                        </Border>

                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Button x:Name="UploadAnotherCvButton"
                    Text="Upload another CV"
                    Clicked="OnUploadCvClicked"
                    BackgroundColor="#DCFCE7"
                    TextColor="#166534"
                    FontAttributes="Bold"
                    CornerRadius="16"
                    HeightRequest="52"
                    Margin="0,0,0,30" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
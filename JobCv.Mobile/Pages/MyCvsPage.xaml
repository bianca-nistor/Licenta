<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="JobCv.Mobile.Pages.MyCvsPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#F1F5F9">

    <ScrollView>
        <VerticalStackLayout Padding="24"
                             Spacing="22">

            <!-- Header -->
            <Grid ColumnDefinitions="Auto,*,Auto"
ColumnSpacing="14"
Margin="0,30,0,0">

                <Button Grid.Column="0"
      Text="☰"
      Clicked="OnMenuClicked"
      BackgroundColor="#E2E8F0"
      TextColor="#0F172A"
      CornerRadius="18"
      WidthRequest="48"
      HeightRequest="48"
      FontSize="22"
      VerticalOptions="Start" />

                <VerticalStackLayout Grid.Column="1"
                   Spacing="4">

                    <Label x:Name="PageTitleLabel"
       Text="My CVs"
       FontSize="34"
       FontAttributes="Bold"
       TextColor="#0F172A"
       MaxLines="1"
       LineBreakMode="TailTruncation" />

                    <Label Text="View, edit, preview and manage all your created and uploaded CVs."
       FontSize="16"
       TextColor="#64748B"
       LineBreakMode="WordWrap" />
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="2"
                   HorizontalOptions="End"
                   VerticalOptions="Start"
                   Spacing="8">

                    <Button Text="👤"
          Clicked="OnProfileClicked"
          BackgroundColor="#DCFCE7"
          TextColor="#0F172A"
          CornerRadius="22"
          WidthRequest="48"
          HeightRequest="48"
          FontSize="18" />

                    <Border x:Name="ProfileMenu"
          IsVisible="False"
          BackgroundColor="White"
          Stroke="#E2E8F0"
          StrokeShape="RoundRectangle 18"
          Padding="12"
          WidthRequest="210"
          Shadow="5,5,12,#22000000">

                        <VerticalStackLayout Spacing="8">

                            <Label Text="Profile"
                 FontSize="18"
                 FontAttributes="Bold"
                 TextColor="#0F172A"
                 Margin="4,0,4,6" />

                            <Button Text="View profile"
                  Clicked="OnViewProfileClicked"
                  BackgroundColor="#EFF6FF"
                  TextColor="#1D4ED8"
                  CornerRadius="12"
                  HeightRequest="44" />

                            <Button Text="Logout"
                  Clicked="OnLogoutClicked"
                  BackgroundColor="#FEE2E2"
                  TextColor="#DC2626"
                  CornerRadius="12"
                  HeightRequest="44" />

                        </VerticalStackLayout>
                    </Border>

                </VerticalStackLayout>
            </Grid>
            <!-- Hamburger menu -->
            <Border x:Name="MainMenu"
  IsVisible="False"
  BackgroundColor="White"
  Stroke="#E2E8F0"
  StrokeShape="RoundRectangle 22"
  Padding="14"
  Shadow="5,5,12,#22000000">

                <VerticalStackLayout Spacing="10">

                    <Label Text="Menu"
         FontSize="18"
         FontAttributes="Bold"
         TextColor="#0F172A"
         Margin="4,0,4,4" />
                    <Button Text="Dashboard"
        Clicked="OnDashboardClicked"
        BackgroundColor="#EFF6FF"
        TextColor="#1D4ED8"
        FontAttributes="Bold"
        CornerRadius="14"
        HeightRequest="46" />

                    <Button Text="My CVs"
        Clicked="OnMyCvsClicked"
        BackgroundColor="#1D4ED8"
        TextColor="White"
        FontAttributes="Bold"
        CornerRadius="14"
        HeightRequest="46" />
                    <Button Text="Applications"
          Clicked="OnMyApplicationsClicked"
          BackgroundColor="#EFF6FF"
          TextColor="#1D4ED8"
          FontAttributes="Bold"
          CornerRadius="14"
          HeightRequest="46" />

                    <Button Text="Jobs"
          Clicked="OnFindJobsClicked"
          BackgroundColor="#EFF6FF"
          TextColor="#1D4ED8"
          FontAttributes="Bold"
          CornerRadius="14"
          HeightRequest="46" />

                </VerticalStackLayout>
            </Border>

            
                <!-- Created CVs -->
            <VerticalStackLayout Spacing="8"
                                 Margin="0,8,0,0">

                <Label Text="Created CVs"
                       FontSize="24"
                       FontAttributes="Bold"
                       TextColor="#0F172A" />

                <Label Text="CVs built and edited inside the application."
                       FontSize="14"
                       TextColor="#64748B" />
            </VerticalStackLayout>

            <Border x:Name="EmptyCreatedCvsState"
                    BackgroundColor="White"
                    Stroke="#E2E8F0"
                    StrokeShape="RoundRectangle 24"
                    Padding="22"
                    IsVisible="False">

                <VerticalStackLayout Spacing="10"
                                     HorizontalOptions="Center">

                    <Label Text="No created CVs yet"
                           FontSize="20"
                           FontAttributes="Bold"
                           TextColor="#0F172A"
                           HorizontalTextAlignment="Center" />

                    <Label Text="Create your first structured CV to edit sections and export it later."
                           FontSize="14"
                           TextColor="#64748B"
                           HorizontalTextAlignment="Center" />

                    <Button Text="Create your first CV"
                            Clicked="OnCreateCvClicked"
                            BackgroundColor="#DCFCE7"
                            TextColor="#166534"
                            FontAttributes="Bold"
                            CornerRadius="16"
                            WidthRequest="220"
                            HeightRequest="48" />
                </VerticalStackLayout>
            </Border>

            <CollectionView x:Name="CvsCollectionView"
                            SelectionMode="None">

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border BackgroundColor="White"
                                Stroke="#E2E8F0"
                                StrokeShape="RoundRectangle 24"
                                Padding="18"
                                Margin="0,0,0,12">

                            <VerticalStackLayout Spacing="12">

                                <Grid ColumnDefinitions="*,Auto"
                                      ColumnSpacing="10">

                                    <VerticalStackLayout Spacing="4">
                                        <Label Text="{Binding Title}"
                                               FontSize="20"
                                               FontAttributes="Bold"
                                               TextColor="#0F172A" />

                                        <Label Text="{Binding Summary}"
                                               FontSize="13"
                                               TextColor="#64748B"
                                               LineBreakMode="TailTruncation"
                                               MaxLines="2" />
                                    </VerticalStackLayout>

                                    <Border Grid.Column="1"
                                            BackgroundColor="#DBEAFE"
                                            Stroke="#BFDBFE"
                                            StrokeShape="RoundRectangle 14"
                                            Padding="10,6"
                                            VerticalOptions="Start">

                                        <Label Text="{Binding LanguageDisplay}"
                                               TextColor="#1D4ED8"
                                               FontAttributes="Bold"
                                               FontSize="12" />
                                    </Border>
                                </Grid>

                                <BoxView HeightRequest="1"
                                         BackgroundColor="#E2E8F0" />

                                <FlexLayout
    Direction="Row"
    Wrap="Wrap"
    JustifyContent="SpaceBetween"
    AlignItems="Center"
    Margin="0,16,0,0">

                                    <Button
    Text="Details"
    Clicked="OnViewDetailsClicked"
    CommandParameter="{Binding Id}"
    BackgroundColor="#EEF4FF"
    TextColor="#1D4ED8"
    FontAttributes="Bold"
    CornerRadius="14"
    HeightRequest="44"
    WidthRequest="135"
    Margin="0,0,8,8" />

                                    <Button
        Text="Preview"
        Clicked="OnPreviewCvPdfClicked"
        CommandParameter="{Binding .}"
        BackgroundColor="#DCFCE7"
        TextColor="#166534"
        FontAttributes="Bold"
        CornerRadius="14"
        HeightRequest="44"
        WidthRequest="135"
        Margin="0,0,8,8" />

                                    <Button
    Text="Quality"
    Clicked="OnCheckCvQualityClicked"
    CommandParameter="{Binding Id}"
    BackgroundColor="#FEF3C7"
    TextColor="#92400E"
    FontAttributes="Bold"
    CornerRadius="14"
    HeightRequest="44"
    WidthRequest="135"
    Margin="0,0,8,8" />

                                    <Button
        Text="Delete"
        Clicked="OnDeleteCvClicked"
        CommandParameter="{Binding Id}"
        BackgroundColor="#FEE2E2"
        TextColor="#DC2626"
        FontAttributes="Bold"
        CornerRadius="14"
        HeightRequest="44"
        WidthRequest="135"
        Margin="0,0,0,8" />

                                </FlexLayout>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- Uploaded CVs -->
            <VerticalStackLayout Spacing="8"
                                 Margin="0,12,0,0">

                <Label Text="Uploaded CVs"
                       FontSize="24"
                       FontAttributes="Bold"
                       TextColor="#0F172A" />

                <Label Text="Files uploaded by you. These can be used later when applying to jobs."
                       FontSize="14"
                       TextColor="#64748B" />
            </VerticalStackLayout>

            <Border x:Name="EmptyUploadedCvsState"
                    BackgroundColor="White"
                    Stroke="#E2E8F0"
                    StrokeShape="RoundRectangle 24"
                    Padding="22"
                    IsVisible="False">

                <VerticalStackLayout Spacing="10"
                                     HorizontalOptions="Center">

                    <Label Text="No uploaded CVs yet"
                           FontSize="20"
                           FontAttributes="Bold"
                           TextColor="#0F172A"
                           HorizontalTextAlignment="Center" />

                    <Label Text="Upload an existing PDF, DOC or DOCX CV."
                           FontSize="14"
                           TextColor="#64748B"
                           HorizontalTextAlignment="Center" />

                    <Button Text="Upload CV"
                            Clicked="OnUploadCvClicked"
                            BackgroundColor="#DCFCE7"
                            TextColor="#166534"
                            FontAttributes="Bold"
                            CornerRadius="16"
                            WidthRequest="180"
                            HeightRequest="48" />
                </VerticalStackLayout>
            </Border>

            <CollectionView x:Name="UploadedCvsCollectionView"
                            SelectionMode="None">

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border BackgroundColor="White"
                                Stroke="#E2E8F0"
                                StrokeShape="RoundRectangle 24"
                                Padding="18"
                                Margin="0,0,0,12">

                            <VerticalStackLayout Spacing="12">

                                <Grid ColumnDefinitions="*,Auto"
                                      ColumnSpacing="10">

                                    <VerticalStackLayout Spacing="4">
                                        <Label Text="{Binding OriginalFileName}"
                                               FontSize="20"
                                               FontAttributes="Bold"
                                               TextColor="#0F172A" />

                                        <Label Text="{Binding DisplaySize}"
                                               FontSize="13"
                                               TextColor="#64748B" />
                                    </VerticalStackLayout>

                                    <Border Grid.Column="1"
                                            BackgroundColor="#DCFCE7"
                                            Stroke="#BBF7D0"
                                            StrokeShape="RoundRectangle 14"
                                            Padding="10,6"
                                            VerticalOptions="Start">

                                        <Label Text="uploaded"
                                               TextColor="#166534"
                                               FontAttributes="Bold"
                                               FontSize="12" />
                                    </Border>
                                </Grid>

                                <BoxView HeightRequest="1"
                                         BackgroundColor="#E2E8F0" />

                                <Grid ColumnDefinitions="*,Auto"
                                      ColumnSpacing="10">

                                    <Button Text="Open"
                                            Clicked="OnOpenUploadedCvClicked"
                                            CommandParameter="{Binding .}"
                                            BackgroundColor="#EFF6FF"
                                            TextColor="#1D4ED8"
                                            FontAttributes="Bold"
                                            CornerRadius="14"
                                            HeightRequest="44" />

                                    <Button Grid.Column="1"
                                            Text="Delete"
                                            Clicked="OnDeleteUploadedCvClicked"
                                            CommandParameter="{Binding Id}"
                                            BackgroundColor="#FEE2E2"
                                            TextColor="#DC2626"
                                            FontAttributes="Bold"
                                            CornerRadius="14"
                                            WidthRequest="110"
                                            HeightRequest="44" />
                                </Grid>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Button Text="Upload another CV"
                    Clicked="OnUploadCvClicked"
                    BackgroundColor="#DCFCE7"
                    TextColor="#166534"
                    FontAttributes="Bold"
                    CornerRadius="16"
                    HeightRequest="52"
                    Margin="0,0,0,30" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
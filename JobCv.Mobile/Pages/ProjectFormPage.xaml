<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="JobCv.Mobile.Pages.ProjectFormPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#F8FAFC">

    <ScrollView>
        <VerticalStackLayout Padding="24"
                             Spacing="20">

            <Grid ColumnDefinitions="*"
                  Margin="0,20,0,0">


                <VerticalStackLayout Grid.Column="0"
                                     Spacing="4">

                    <Label x:Name="PageTitleLabel"
                           Text="Add Project"
                           FontSize="32"
                           FontAttributes="Bold"
                           TextColor="#0F172A" />

                    <Label Text="Add a project, portfolio item or academic work."
                           FontSize="14"
                           TextColor="#64748B" />
                </VerticalStackLayout>
            </Grid>

            <Border BackgroundColor="White"
                    Stroke="#E2E8F0"
                    StrokeShape="RoundRectangle 26"
                    Padding="22">

                <VerticalStackLayout Spacing="16">

                    <VerticalStackLayout Spacing="8">
                        <Label Text="Project title"
                               FontSize="14"
                               FontAttributes="Bold"
                               TextColor="#0F172A" />

                        <Entry x:Name="TitleEntry"
                               Placeholder="Example: Career Guide Mobile App"
                               BackgroundColor="#F8FAFC"
                               TextColor="#0F172A"
                               PlaceholderColor="#94A3B8"
                               HeightRequest="52" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="8">
                        <Label Text="Technologies"
                               FontSize="14"
                               FontAttributes="Bold"
                               TextColor="#0F172A" />

                        <Entry x:Name="TechnologiesEntry"
                               Placeholder="Example: C#, .NET MAUI, ASP.NET Core, SQLite"
                               BackgroundColor="#F8FAFC"
                               TextColor="#0F172A"
                               PlaceholderColor="#94A3B8"
                               HeightRequest="52" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="8">
                        <Label Text="Description"
                               FontSize="14"
                               FontAttributes="Bold"
                               TextColor="#0F172A" />

                        <Editor x:Name="DescriptionEditor"
                                Placeholder="Describe what the project does and your contribution..."
                                BackgroundColor="#F8FAFC"
                                TextColor="#0F172A"
                                PlaceholderColor="#94A3B8"
                                HeightRequest="130" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="8">
                        <Label Text="Project URL"
                               FontSize="14"
                               FontAttributes="Bold"
                               TextColor="#0F172A" />

                        <Entry x:Name="ProjectUrlEntry"
                               Placeholder="Optional"
                               Keyboard="Url"
                               BackgroundColor="#F8FAFC"
                               TextColor="#0F172A"
                               PlaceholderColor="#94A3B8"
                               HeightRequest="52" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="8">
                        <Label Text="GitHub URL"
                               FontSize="14"
                               FontAttributes="Bold"
                               TextColor="#0F172A" />

                        <Entry x:Name="GitHubUrlEntry"
                               Placeholder="Optional"
                               Keyboard="Url"
                               BackgroundColor="#F8FAFC"
                               TextColor="#0F172A"
                               PlaceholderColor="#94A3B8"
                               HeightRequest="52" />
                    </VerticalStackLayout>

                    <Label x:Name="MessageLabel"
                           Text=""
                           FontSize="13"
                           TextColor="#DC2626" />

                    <Button x:Name="SaveButton"
                            Text="Save project"
                            Clicked="OnSaveClicked"
                            BackgroundColor="#1D4ED8"
                            TextColor="White"
                            FontAttributes="Bold"
                            CornerRadius="16"
                            HeightRequest="54" />

                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
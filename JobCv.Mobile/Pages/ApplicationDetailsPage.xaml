<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="JobCv.Mobile.Pages.ApplicationDetailsPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#F1F5F9">

    <ScrollView>
        <VerticalStackLayout Padding="24"
                             Spacing="20">

            <Grid ColumnDefinitions="*"
                  ColumnSpacing="14"
                  Margin="0,30,0,0">

                <VerticalStackLayout Grid.Column="0"
                                     Spacing="4">
                    <Label Text="Detalii aplicare"
                           FontSize="34"
                           FontAttributes="Bold"
                           TextColor="#0F172A" />
                    <Label Text="Editează statusul, notițele și detaliile de interviu pentru această aplicare."
                           FontSize="15"
                           TextColor="#64748B" />
                </VerticalStackLayout>
            </Grid>

            <Border BackgroundColor="White"
                    Stroke="#E2E8F0"
                    StrokeShape="RoundRectangle 28"
                    Padding="20">
                <VerticalStackLayout Spacing="14">
                    <Label Text="Informații job"
                           FontSize="22"
                           FontAttributes="Bold"
                           TextColor="#0F172A" />

                    <Entry x:Name="JobTitleEntry"
                           Placeholder="Titlu job"
                           BackgroundColor="#F8FAFC"
                           TextColor="#0F172A" />

                    <Entry x:Name="CompanyEntry"
                           Placeholder="Companie"
                           BackgroundColor="#F8FAFC"
                           TextColor="#0F172A" />

                    <Entry x:Name="LocationEntry"
                           Placeholder="Locație"
                           BackgroundColor="#F8FAFC"
                           TextColor="#0F172A" />

                    <Entry x:Name="JobUrlEntry"
                           Placeholder="Link job"
                           Keyboard="Url"
                           BackgroundColor="#F8FAFC"
                           TextColor="#0F172A" />

                    <Entry x:Name="SourceEntry"
                           Placeholder="Sursă"
                           BackgroundColor="#F8FAFC"
                           TextColor="#0F172A" />
                </VerticalStackLayout>
            </Border>

            <Border BackgroundColor="White"
                    Stroke="#E2E8F0"
                    StrokeShape="RoundRectangle 28"
                    Padding="20">
                <VerticalStackLayout Spacing="14">
                    <Label Text="Progres aplicare"
                           FontSize="22"
                           FontAttributes="Bold"
                           TextColor="#0F172A" />

                    <Label Text="Status"
                           FontAttributes="Bold"
                           TextColor="#0F172A" />

                    <Border BackgroundColor="#F8FAFC"
        Stroke="#E2E8F0"
        StrokeShape="RoundRectangle 16"
        Padding="12,4">

                        <Picker x:Name="StatusPicker"
            Title="Alege statusul"
            BackgroundColor="Transparent"
            TextColor="#0F172A"
            TitleColor="#64748B">

                            <Picker.Items>
                                <x:String>Salvat</x:String>
                                <x:String>Aplicat</x:String>
                                <x:String>Interviu programat</x:String>
                                <x:String>Interviu finalizat</x:String>
                                <x:String>Ofertă</x:String>
                                <x:String>Respins</x:String>
                            </Picker.Items>

                        </Picker>

                    </Border>
                    <Label Text="CV utilizat"
                           FontAttributes="Bold"
                           TextColor="#0F172A" />

                    <Picker x:Name="CvPicker"
                            ItemDisplayBinding="{Binding Title}"
                            BackgroundColor="#F8FAFC"
                            TextColor="#0F172A" />

                    <Entry x:Name="SalaryRangeEntry"
                           Placeholder="Interval salarial"
                           BackgroundColor="#F8FAFC"
                           TextColor="#0F172A" />

                    <Entry x:Name="ContactPersonEntry"
                           Placeholder="Recrutor / persoană de contact"
                           BackgroundColor="#F8FAFC"
                           TextColor="#0F172A" />

                    <Border BackgroundColor="#F8FAFC"
                            Stroke="#E2E8F0"
                            StrokeShape="RoundRectangle 18"
                            Padding="14">
                        <VerticalStackLayout Spacing="10">
                            <HorizontalStackLayout Spacing="10">
                                <CheckBox x:Name="UseAppliedDateCheckBox"
                                          CheckedChanged="OnUseAppliedDateChanged" />
                                <Label Text="Data aplicării"
                                       VerticalOptions="Center"
                                       TextColor="#0F172A" />
                            </HorizontalStackLayout>

                            <DatePicker x:Name="AppliedDatePicker"
                                        IsEnabled="False"
                                        BackgroundColor="White"
                                        TextColor="#0F172A" />
                        </VerticalStackLayout>
                    </Border>

                    <Border BackgroundColor="#F8FAFC"
                            Stroke="#E2E8F0"
                            StrokeShape="RoundRectangle 18"
                            Padding="14">
                        <VerticalStackLayout Spacing="10">
                            <HorizontalStackLayout Spacing="10">
                                <CheckBox x:Name="UseInterviewDateCheckBox"
                                          CheckedChanged="OnUseInterviewDateChanged" />
                                <Label Text="Data interviului"
                                       VerticalOptions="Center"
                                       TextColor="#0F172A" />
                            </HorizontalStackLayout>

                            <DatePicker x:Name="InterviewDatePicker"
                                        IsEnabled="False"
                                        BackgroundColor="White"
                                        TextColor="#0F172A" />
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>
            </Border>

            <Border BackgroundColor="White"
                    Stroke="#E2E8F0"
                    StrokeShape="RoundRectangle 28"
                    Padding="20">
                <VerticalStackLayout Spacing="14">
                    <Label Text="Notițe"
                           FontSize="22"
                           FontAttributes="Bold"
                           TextColor="#0F172A" />

                    <Editor x:Name="NotesEditor"
                            Placeholder="Notițe generale: ce ai trimis, contact recrutor, pași următori..."
                            HeightRequest="130"
                            AutoSize="TextChanges"
                            BackgroundColor="#F8FAFC"
                            TextColor="#0F172A" />

                    <Editor x:Name="InterviewNotesEditor"
                            Placeholder="Notițe pentru pregătirea interviului..."
                            HeightRequest="130"
                            AutoSize="TextChanges"
                            BackgroundColor="#F8FAFC"
                            TextColor="#0F172A" />
                </VerticalStackLayout>
            </Border>
            <Border BackgroundColor="White"
        Stroke="#E2E8F0"
        StrokeShape="RoundRectangle 28"
        Padding="20">

                <VerticalStackLayout Spacing="14">

                    <Label Text="Scrisoare de intenție AI"
               FontSize="22"
               FontAttributes="Bold"
               TextColor="#0F172A" />

                    <Label Text="Generează o scrisoare de intenție scurtă pentru această aplicare, folosind CV-ul selectat și detaliile jobului."
               FontSize="14"
               TextColor="#64748B"
               LineBreakMode="WordWrap" />

                    <Button Text="Generează scrisoarea de intenție"
                Clicked="OnGenerateCoverLetterClicked"
                BackgroundColor="#7C3AED"
                FontSize="13"
                FontAutoScalingEnabled="False"
                TextColor="White"
                FontAttributes="Bold"
                CornerRadius="16"
                HeightRequest="54" />

                    <Label x:Name="CoverLetterSubjectLabel"
               Text=""
               FontSize="15"
               FontAttributes="Bold"
               TextColor="#0F172A"
               IsVisible="False"
               LineBreakMode="WordWrap" />

                    <Editor x:Name="CoverLetterEditor"
                Placeholder="Scrisoarea de intenție generată va apărea aici..."
                HeightRequest="220"
                AutoSize="TextChanges"
                BackgroundColor="#F8FAFC"
                TextColor="#0F172A"
                IsVisible="False" />

                    <Button x:Name="CopyCoverLetterButton"
                Text="Copiază scrisoarea de intenție"
                Clicked="OnCopyCoverLetterClicked"
                BackgroundColor="#EFF6FF"
                FontSize="13"
                FontAutoScalingEnabled="False"
                TextColor="#1D4ED8"
                BorderColor="#93C5FD"
                BorderWidth="1"
                FontAttributes="Bold"
                CornerRadius="16"
                HeightRequest="50"
                IsVisible="False" />

                </VerticalStackLayout>
            </Border>
            <Grid ColumnDefinitions="*,*"
                  RowDefinitions="Auto,Auto"
                  ColumnSpacing="12"
                  RowSpacing="12">
                <Button Text="Deschide jobul"
                        Clicked="OnOpenJobClicked"
                        BackgroundColor="White"
                        FontSize="13"
                        FontAutoScalingEnabled="False"
                        TextColor="#1D4ED8"
                        BorderColor="#93C5FD"
                        BorderWidth="1"
                        FontAttributes="Bold"
                        CornerRadius="16"
                        HeightRequest="54" />

                <Button Grid.Column="1"
                        Text="Pregătire interviu"
                        Clicked="OnPrepareInterviewClicked"
                        BackgroundColor="#16A34A"
                        FontSize="13"
                        FontAutoScalingEnabled="False"
                        TextColor="White"
                        FontAttributes="Bold"
                        CornerRadius="16"
                        HeightRequest="54" />

                <Button Grid.Row="1"
                        Grid.ColumnSpan="2"
                        Text="Salvează modificările"
                        Clicked="OnSaveClicked"
                        BackgroundColor="#1D4ED8"
                        FontSize="13"
                        FontAutoScalingEnabled="False"
                        TextColor="White"
                        FontAttributes="Bold"
                        CornerRadius="16"
                        HeightRequest="56" />
            </Grid>

            <Label x:Name="MessageLabel"
                   Text=""
                   FontSize="14"
                   TextColor="#64748B" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>

<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="JobCv.Mobile.Pages.CvJobMatchPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#F1F5F9">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="18">

            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14" Margin="0,30,0,0">
                <Button Grid.Column="0"
                        Text="‹"
                        Clicked="OnBackClicked"
                        BackgroundColor="#E2E8F0"
                        TextColor="#0F172A"
                        CornerRadius="18"
                        WidthRequest="48"
                        HeightRequest="48"
                        FontSize="30" />

                <VerticalStackLayout Grid.Column="1" Spacing="4">
                    <Label Text="AI Match Score"
                           FontSize="32"
                           FontAttributes="Bold"
                           TextColor="#0F172A" />

                    <Label Text="Compare one of your CVs with the selected job and get an explainable score."
                           FontSize="15"
                           TextColor="#64748B"
                           LineBreakMode="WordWrap" />
                </VerticalStackLayout>
            </Grid>

            <Border BackgroundColor="White"
                    Stroke="#E2E8F0"
                    StrokeShape="RoundRectangle 24"
                    Padding="18">

                <VerticalStackLayout Spacing="10">
                    <Label x:Name="JobTitleLabel"
                           Text="Selected job"
                           FontSize="22"
                           FontAttributes="Bold"
                           TextColor="#0F172A" />

                    <Label x:Name="CompanyLabel"
                           Text="Company"
                           FontSize="15"
                           TextColor="#334155" />

                    <Label x:Name="LocationLabel"
                           Text="Location"
                           FontSize="14"
                           TextColor="#64748B" />

                    <BoxView HeightRequest="1" BackgroundColor="#E2E8F0" Margin="0,4" />

                    <Label x:Name="DescriptionLabel"
                           Text="Job description"
                           FontSize="14"
                           TextColor="#475569"
                           LineBreakMode="WordWrap"
                           MaxLines="8" />
                </VerticalStackLayout>
            </Border>

            <Border BackgroundColor="White"
                    Stroke="#E2E8F0"
                    StrokeShape="RoundRectangle 24"
                    Padding="18">

                <VerticalStackLayout Spacing="12">
                    <Label Text="Choose CV"
                           FontSize="22"
                           FontAttributes="Bold"
                           TextColor="#0F172A" />

                    <Picker x:Name="CvPicker"
                            Title="Select a CV"
                            ItemDisplayBinding="{Binding Title}"
                            SelectedIndexChanged="OnCvSelected"
                            BackgroundColor="#F8FAFC"
                            TextColor="#0F172A" />

                    <Border x:Name="SelectedCvInfoBorder"
                            IsVisible="False"
                            BackgroundColor="#EFF6FF"
                            Stroke="#BFDBFE"
                            StrokeShape="RoundRectangle 18"
                            Padding="14">
                        <VerticalStackLayout Spacing="3">
                            <Label x:Name="SelectedCvTitleLabel"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   TextColor="#1D4ED8" />
                            <Label x:Name="SelectedCvSubtitleLabel"
                                   FontSize="13"
                                   TextColor="#475569" />
                        </VerticalStackLayout>
                    </Border>

                    <Button Text="Use manual CV text instead"
                            Clicked="OnToggleManualTextClicked"
                            BackgroundColor="#F8FAFC"
                            TextColor="#1D4ED8"
                            FontAttributes="Bold"
                            BorderColor="#BFDBFE"
                            BorderWidth="1"
                            CornerRadius="16"
                            HeightRequest="48" />

                    <VerticalStackLayout x:Name="ManualCvTextLayout"
                                         IsVisible="False"
                                         Spacing="8">
                        <Label Text="Paste CV text"
                               FontSize="14"
                               FontAttributes="Bold"
                               TextColor="#334155" />

                        <Editor x:Name="CvTextEditor"
                                Placeholder="Paste your CV text here..."
                                AutoSize="TextChanges"
                                MinimumHeightRequest="160"
                                BackgroundColor="#F8FAFC"
                                TextColor="#0F172A"
                                PlaceholderColor="#94A3B8" />
                    </VerticalStackLayout>

                    <Button Text="Generate match score"
                            Clicked="OnGenerateClicked"
                            BackgroundColor="#7C3AED"
                            TextColor="White"
                            FontAttributes="Bold"
                            CornerRadius="16"
                            HeightRequest="52" />

                    <ActivityIndicator x:Name="LoadingIndicator"
                                       IsVisible="False"
                                       IsRunning="False"
                                       Color="#7C3AED" />

                    <Label x:Name="MessageLabel"
                           Text=""
                           FontSize="13"
                           TextColor="#64748B" />
                </VerticalStackLayout>
            </Border>

            <VerticalStackLayout x:Name="ResultsLayout"
                                 IsVisible="False"
                                 Spacing="14">

                <Border x:Name="ScoreCard"
                        BackgroundColor="White"
                        Stroke="#E2E8F0"
                        StrokeShape="RoundRectangle 24"
                        Padding="20">
                    <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                        <Label x:Name="ScoreLabel"
                               Text="0%"
                               FontSize="54"
                               FontAttributes="Bold"
                               TextColor="#7C3AED"
                               HorizontalTextAlignment="Center" />

                        <Label x:Name="RecommendationLabel"
                               Text="Recommendation"
                               FontSize="20"
                               FontAttributes="Bold"
                               TextColor="#0F172A"
                               HorizontalTextAlignment="Center" />

                        <Label x:Name="SummaryLabel"
                               Text="Summary"
                               FontSize="14"
                               TextColor="#64748B"
                               HorizontalTextAlignment="Center"
                               LineBreakMode="WordWrap" />
                    </VerticalStackLayout>
                </Border>

                <Border BackgroundColor="White"
                        Stroke="#E2E8F0"
                        StrokeShape="RoundRectangle 24"
                        Padding="18">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Strengths"
                               FontSize="20"
                               FontAttributes="Bold"
                               TextColor="#166534" />
                        <CollectionView x:Name="StrengthsCollectionView" SelectionMode="None">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Label Text="{Binding .}"
                                           FontSize="14"
                                           TextColor="#334155"
                                           Margin="0,3" />
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </Border>

                <Border BackgroundColor="White"
                        Stroke="#E2E8F0"
                        StrokeShape="RoundRectangle 24"
                        Padding="18">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Missing / weak areas"
                               FontSize="20"
                               FontAttributes="Bold"
                               TextColor="#B45309" />
                        <CollectionView x:Name="MissingCollectionView" SelectionMode="None">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Label Text="{Binding .}"
                                           FontSize="14"
                                           TextColor="#334155"
                                           Margin="0,3" />
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </Border>

                <Border BackgroundColor="White"
                        Stroke="#E2E8F0"
                        StrokeShape="RoundRectangle 24"
                        Padding="18"
                        Margin="0,0,0,30">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="What to improve"
                               FontSize="20"
                               FontAttributes="Bold"
                               TextColor="#1D4ED8" />
                        <CollectionView x:Name="ImprovementsCollectionView" SelectionMode="None">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Label Text="{Binding .}"
                                           FontSize="14"
                                           TextColor="#334155"
                                           Margin="0,3" />
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>

<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="JobCv.Mobile.Pages.CareerTestPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#F1F5F9">

    <ScrollView>
        <VerticalStackLayout Padding="18"
                             Spacing="18">

            <Grid ColumnDefinitions="*"
                  ColumnSpacing="12"
                  Margin="0,26,0,0">


                <VerticalStackLayout Grid.Column="0"
                                     Spacing="4">

                    <Label x:Name="TitleLabel"
                           Text="Career Interest Profiler"
                           FontSize="28"
                           FontAttributes="Bold"
                           TextColor="#0F172A"
                           LineBreakMode="WordWrap" />

                    <Label x:Name="SubtitleLabel"
                           Text="Read each work activity and choose whether you would like to do it. The result is based on the O*NET Interest Profiler Short Form scoring model."
                           FontSize="14"
                           TextColor="#64748B"
                           LineBreakMode="WordWrap" />

                </VerticalStackLayout>
            </Grid>

            <Border BackgroundColor="#FEF3C7"
                    Stroke="#FDE68A"
                    StrokeShape="RoundRectangle 22"
                    Padding="16">

                <VerticalStackLayout Spacing="6">
                    <Label x:Name="ImportantTitleLabel"
                           Text="Important"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="#92400E" />

                    <Label x:Name="ImportantTextLabel"
                           Text="Your answers and result are not saved automatically. If you want to keep the result, download the PDF report at the end of the test."
                           FontSize="14"
                           TextColor="#92400E"
                           LineBreakMode="WordWrap" />
                </VerticalStackLayout>
            </Border>

            <Border BackgroundColor="White"
                    Stroke="#E2E8F0"
                    StrokeShape="RoundRectangle 28"
                    Padding="20">

                <VerticalStackLayout Spacing="16">

                    <Label x:Name="ProgressLabel"
                           Text="Question 1 of 60"
                           FontSize="14"
                           FontAttributes="Bold"
                           TextColor="#1D4ED8" />

                    <ProgressBar x:Name="QuestionProgressBar"
                                 Progress="0.016"
                                 ProgressColor="#1D4ED8"
                                 BackgroundColor="#E2E8F0" />

                    <Label x:Name="AreaLabel"
                           Text="Realistic"
                           FontSize="13"
                           TextColor="#64748B" />

                    <Label x:Name="QuestionLabel"
                           Text="Question text"
                           FontSize="22"
                           FontAttributes="Bold"
                           TextColor="#0F172A"
                           LineBreakMode="WordWrap" />

                    <VerticalStackLayout Spacing="10">

                        <Button x:Name="LikeButton"
                                Text="I would like to do this"
                                Clicked="OnAnswerClicked"
                                CommandParameter="true"
                                BackgroundColor="#F8FAFC"
                                TextColor="#0F172A"
                                BorderColor="#CBD5E1"
                                BorderWidth="1"
                                CornerRadius="16"
                                HeightRequest="54" />

                        <Button x:Name="DislikeButton"
                                Text="I would not like to do this"
                                Clicked="OnAnswerClicked"
                                CommandParameter="false"
                                BackgroundColor="#F8FAFC"
                                TextColor="#0F172A"
                                BorderColor="#CBD5E1"
                                BorderWidth="1"
                                CornerRadius="16"
                                HeightRequest="54" />

                    </VerticalStackLayout>

                    <Grid ColumnDefinitions="*,*"
                          ColumnSpacing="10">

                        <Button x:Name="PreviousButton"
                                Text="Previous"
                                Clicked="OnPreviousClicked"
                                BackgroundColor="#EFF6FF"
                                TextColor="#1D4ED8"
                                BorderColor="#93C5FD"
                                BorderWidth="1"
                                FontAttributes="Bold"
                                CornerRadius="16"
                                HeightRequest="52" />

                        <Button x:Name="NextButton"
                                Grid.Column="1"
                                Text="Next"
                                Clicked="OnNextClicked"
                                BackgroundColor="#1D4ED8"
                                TextColor="White"
                                FontAttributes="Bold"
                                CornerRadius="16"
                                HeightRequest="52" />

                    </Grid>

                    <Label x:Name="MessageLabel"
                           Text=""
                           FontSize="14"
                           TextColor="#DC2626"
                           IsVisible="False"
                           LineBreakMode="WordWrap" />

                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>

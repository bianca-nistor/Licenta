<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="JobCv.Mobile.Pages.CvTailoringPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Shell.NavBarIsVisible="False"
    BackgroundColor="#F8FAFC">

    <ScrollView>
        <VerticalStackLayout Padding="24"
                             Spacing="18">

            <!-- Header -->
            <Grid ColumnDefinitions="*"
                  ColumnSpacing="14"
                  Margin="0,20,0,0">


                <VerticalStackLayout Grid.Column="0"
                                     Spacing="4">

                    <Label Text="Tailor CV"
                           FontSize="34"
                           FontAttributes="Bold"
                           TextColor="#0F172A" />

                    <Label Text="Generate suggestions to adapt your CV for this job."
                           FontSize="16"
                           TextColor="#64748B"
                           LineBreakMode="WordWrap" />

                </VerticalStackLayout>
            </Grid>

            <!-- Job info -->
            <Border BackgroundColor="White"
                    Stroke="#E2E8F0"
                    StrokeShape="RoundRectangle 24"
                    Padding="20">

                <VerticalStackLayout Spacing="8">

                    <Label x:Name="JobTitleLabel"
                           FontSize="24"
                           FontAttributes="Bold"
                           TextColor="#0F172A" />

                    <Label x:Name="CompanyLabel"
                           FontSize="16"
                           TextColor="#334155" />

                    <Label x:Name="LocationLabel"
                           FontSize="14"
                           TextColor="#64748B" />

                    <Label x:Name="DescriptionLabel"
                           FontSize="14"
                           TextColor="#475569"
                           LineBreakMode="WordWrap"
                           MaxLines="5" />

                </VerticalStackLayout>
            </Border>

            <!-- CV source selection -->
            <Border BackgroundColor="White"
        Stroke="#E2E8F0"
        StrokeShape="RoundRectangle 24"
        Padding="18">

                <VerticalStackLayout Spacing="12">

                    <Label Text="Choose a CV to tailor"
               FontSize="20"
               FontAttributes="Bold"
               TextColor="#0F172A" />

                    <Label Text="Select one of your created or uploaded CVs. You can also add manual CV text if needed."
               FontSize="14"
               TextColor="#64748B"
               LineBreakMode="WordWrap" />

                    <Picker x:Name="CvPicker"
                Title="Select a CV"
                ItemDisplayBinding="{Binding Title}"
                TextColor="#0F172A"
                TitleColor="#94A3B8"
                BackgroundColor="#F8FAFC"
                SelectedIndexChanged="OnCvSelected" />

                    <Border x:Name="SelectedCvInfoBorder"
                IsVisible="False"
                BackgroundColor="#EFF6FF"
                Stroke="#BFDBFE"
                StrokeShape="RoundRectangle 16"
                Padding="12">

                        <VerticalStackLayout Spacing="4">

                            <Label x:Name="SelectedCvTitleLabel"
                       FontSize="15"
                       FontAttributes="Bold"
                       TextColor="#1D4ED8" />

                            <Label x:Name="SelectedCvSubtitleLabel"
                       FontSize="13"
                       TextColor="#475569"
                       LineBreakMode="WordWrap" />

                        </VerticalStackLayout>
                    </Border>

                    <Button Text="Use manual CV text instead"
                Clicked="OnToggleManualTextClicked"
                BackgroundColor="White"
                TextColor="#1D4ED8"
                BorderColor="#93C5FD"
                BorderWidth="1"
                FontAttributes="Bold"
                CornerRadius="14"
                HeightRequest="46" />

                    <VerticalStackLayout x:Name="ManualCvTextLayout"
                             IsVisible="False"
                             Spacing="8">

                        <Label Text="Manual CV text"
                   FontSize="16"
                   FontAttributes="Bold"
                   TextColor="#0F172A" />

                        <Editor x:Name="CvTextEditor"
                    Placeholder="Paste your profile, skills or experience section here..."
                    AutoSize="TextChanges"
                    HeightRequest="160"
                    BackgroundColor="#F8FAFC"
                    TextColor="#0F172A"
                    PlaceholderColor="#94A3B8" />

                    </VerticalStackLayout>

                </VerticalStackLayout>
            </Border>

            <Button Text="Generate CV suggestions"
                    Clicked="OnGenerateClicked"
                    BackgroundColor="#1D4ED8"
                    TextColor="White"
                    FontAttributes="Bold"
                    CornerRadius="16"
                    HeightRequest="54" />

            <ActivityIndicator x:Name="LoadingIndicator"
                               IsVisible="False"
                               IsRunning="False"
                               Color="#1D4ED8" />

            <Label x:Name="MessageLabel"
                   Text=""
                   FontSize="14"
                   TextColor="#64748B" />

            <!-- Results -->
            <VerticalStackLayout x:Name="ResultsLayout"
                                 IsVisible="False"
                                 Spacing="18">

                <Border x:Name="AiSourceBanner"
                        BackgroundColor="#ECFDF5"
                        Stroke="#BBF7D0"
                        StrokeShape="RoundRectangle 18"
                        Padding="14">

                    <Label x:Name="AiSourceLabel"
                           Text=""
                           FontSize="13"
                           TextColor="#166534"
                           LineBreakMode="WordWrap" />

                </Border>
                <Border x:Name="CvQualityWarningBorder"
        IsVisible="False"
        BackgroundColor="#FEF3C7"
        Stroke="#FDE68A"
        StrokeShape="RoundRectangle 18"
        Padding="14">

                    <VerticalStackLayout Spacing="6">

                        <Label Text="CV needs more information"
               FontSize="15"
               FontAttributes="Bold"
               TextColor="#92400E" />

                        <Label x:Name="CvQualityWarningLabel"
               Text=""
               FontSize="13"
               TextColor="#92400E"
               LineBreakMode="WordWrap" />

                    </VerticalStackLayout>
                </Border>

                <!-- Tailored profile -->
                <Border BackgroundColor="White"
                        Stroke="#E2E8F0"
                        StrokeShape="RoundRectangle 22"
                        Padding="18">

                    <VerticalStackLayout Spacing="10">

                        <Label Text="Tailored profile summary"
                               FontSize="20"
                               FontAttributes="Bold"
                               TextColor="#0F172A" />

                        <Label x:Name="TailoredSummaryLabel"
                               FontSize="15"
                               TextColor="#475569"
                               LineBreakMode="WordWrap" />

                    </VerticalStackLayout>
                </Border>

                <!-- Keywords -->
                <Border BackgroundColor="White"
                        Stroke="#E2E8F0"
                        StrokeShape="RoundRectangle 22"
                        Padding="18">

                    <VerticalStackLayout Spacing="12">

                        <Label Text="Important keywords"
                               FontSize="20"
                               FontAttributes="Bold"
                               TextColor="#0F172A" />

                        <CollectionView x:Name="KeywordsCollectionView"
                                        SelectionMode="None">

                            <CollectionView.ItemsLayout>
                                <LinearItemsLayout Orientation="Vertical"
                                                   ItemSpacing="8" />
                            </CollectionView.ItemsLayout>

                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Border BackgroundColor="#EFF6FF"
                                            Stroke="#BFDBFE"
                                            StrokeShape="RoundRectangle 16"
                                            Padding="12,8">

                                        <Label Text="{Binding .}"
                                               FontSize="14"
                                               TextColor="#1D4ED8"
                                               FontAttributes="Bold" />

                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>

                    </VerticalStackLayout>
                </Border>

                <!-- Skills -->
                <Border BackgroundColor="White"
                        Stroke="#E2E8F0"
                        StrokeShape="RoundRectangle 22"
                        Padding="18">

                    <VerticalStackLayout Spacing="12">

                        <Label Text="Skills to highlight"
                               FontSize="20"
                               FontAttributes="Bold"
                               TextColor="#0F172A" />

                        <CollectionView x:Name="SkillsCollectionView"
                                        SelectionMode="None">

                            <CollectionView.ItemsLayout>
                                <LinearItemsLayout Orientation="Vertical"
                                                   ItemSpacing="8" />
                            </CollectionView.ItemsLayout>

                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Border BackgroundColor="#F0FDF4"
                                            Stroke="#BBF7D0"
                                            StrokeShape="RoundRectangle 16"
                                            Padding="12,8">

                                        <Label Text="{Binding .}"
                                               FontSize="14"
                                               TextColor="#166534"
                                               FontAttributes="Bold" />

                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>

                    </VerticalStackLayout>
                </Border>

                <!-- Experience -->
                <Border BackgroundColor="White"
                        Stroke="#E2E8F0"
                        StrokeShape="RoundRectangle 22"
                        Padding="18">

                    <VerticalStackLayout Spacing="12">

                        <Label Text="Experience to emphasize"
                               FontSize="20"
                               FontAttributes="Bold"
                               TextColor="#0F172A" />

                        <CollectionView x:Name="ExperienceCollectionView"
                                        SelectionMode="None">

                            <CollectionView.ItemsLayout>
                                <LinearItemsLayout Orientation="Vertical"
                                                   ItemSpacing="8" />
                            </CollectionView.ItemsLayout>

                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Border BackgroundColor="#F8FAFC"
                                            Stroke="#E2E8F0"
                                            StrokeShape="RoundRectangle 16"
                                            Padding="12">

                                        <Label Text="{Binding .}"
                                               FontSize="14"
                                               TextColor="#475569"
                                               LineBreakMode="WordWrap" />

                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>

                    </VerticalStackLayout>
                </Border>

                <!-- Suggestions -->
                <Border BackgroundColor="White"
                        Stroke="#E2E8F0"
                        StrokeShape="RoundRectangle 22"
                        Padding="18">

                    <VerticalStackLayout Spacing="12">

                        <Label Text="CV improvement suggestions"
                               FontSize="20"
                               FontAttributes="Bold"
                               TextColor="#0F172A" />

                        <CollectionView x:Name="SuggestionsCollectionView"
                                        SelectionMode="None">

                            <CollectionView.ItemsLayout>
                                <LinearItemsLayout Orientation="Vertical"
                                                   ItemSpacing="12" />
                            </CollectionView.ItemsLayout>

                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Border BackgroundColor="#F8FAFC"
                                            Stroke="#E2E8F0"
                                            StrokeShape="RoundRectangle 18"
                                            Padding="14">

                                        <VerticalStackLayout Spacing="8">

                                            <Label Text="{Binding Section}"
                                                   FontSize="12"
                                                   TextColor="#1D4ED8"
                                                   FontAttributes="Bold" />

                                            <Label Text="{Binding Suggestion}"
                                                   FontSize="16"
                                                   TextColor="#0F172A"
                                                   FontAttributes="Bold"
                                                   LineBreakMode="WordWrap" />

                                            <Label Text="{Binding Reason}"
                                                   FontSize="14"
                                                   TextColor="#475569"
                                                   LineBreakMode="WordWrap" />

                                        </VerticalStackLayout>

                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>

                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
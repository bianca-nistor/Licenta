<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="JobCv.Mobile.Pages.CertificationFormPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#F8FAFC">

    <ScrollView>
        <VerticalStackLayout Padding="24"
                             Spacing="20">

            <Grid ColumnDefinitions="*"
                  Margin="0,20,0,0">


                <VerticalStackLayout Grid.Column="0"
                                     Spacing="4">

                    <Label x:Name="PageTitleLabel"
                           Text="Add Certification"
                           FontSize="32"
                           FontAttributes="Bold"
                           TextColor="#0F172A" />

                    <Label Text="Add courses, certificates or professional credentials."
                           FontSize="14"
                           TextColor="#64748B" />
                </VerticalStackLayout>
            </Grid>

            <Border BackgroundColor="White"
                    Stroke="#E2E8F0"
                    StrokeShape="RoundRectangle 26"
                    Padding="22">

                <VerticalStackLayout Spacing="16">

                    <VerticalStackLayout Spacing="8">
                        <Label Text="Certification name"
                               FontSize="14"
                               FontAttributes="Bold"
                               TextColor="#0F172A" />

                        <Entry x:Name="NameEntry"
                               Placeholder="Example: Microsoft Azure Fundamentals"
                               BackgroundColor="#F8FAFC"
                               TextColor="#0F172A"
                               PlaceholderColor="#94A3B8"
                               HeightRequest="52" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="8">
                        <Label Text="Issuer"
                               FontSize="14"
                               FontAttributes="Bold"
                               TextColor="#0F172A" />

                        <Entry x:Name="IssuerEntry"
                               Placeholder="Example: Microsoft"
                               BackgroundColor="#F8FAFC"
                               TextColor="#0F172A"
                               PlaceholderColor="#94A3B8"
                               HeightRequest="52" />
                    </VerticalStackLayout>

                    <Border BackgroundColor="#F8FAFC"
                            Stroke="#E2E8F0"
                            StrokeShape="RoundRectangle 18"
                            Padding="14">

                        <VerticalStackLayout Spacing="10">

                            <HorizontalStackLayout Spacing="8">
                                <CheckBox x:Name="UseDateCheckBox"
                                          Color="#1D4ED8"
                                          CheckedChanged="OnUseDateChanged" />

                                <Label Text="Add certification date"
                                       TextColor="#0F172A"
                                       VerticalOptions="Center" />
                            </HorizontalStackLayout>

                            <DatePicker x:Name="CertificationDatePicker"
                                        IsEnabled="False"
                                        BackgroundColor="White"
                                        TextColor="#0F172A"
                                        HeightRequest="48" />
                        </VerticalStackLayout>
                    </Border>

                    <VerticalStackLayout Spacing="8">
                        <Label Text="Certificate URL"
                               FontSize="14"
                               FontAttributes="Bold"
                               TextColor="#0F172A" />

                        <Entry x:Name="UrlEntry"
                               Placeholder="Optional"
                               Keyboard="Url"
                               BackgroundColor="#F8FAFC"
                               TextColor="#0F172A"
                               PlaceholderColor="#94A3B8"
                               HeightRequest="52" />
                    </VerticalStackLayout>

                    <Label x:Name="MessageLabel"
                           Text=""
                           FontSize="13"
                           TextColor="#DC2626" />

                    <Button x:Name="SaveButton"
                            Text="Save certification"
                            Clicked="OnSaveClicked"
                            BackgroundColor="#1D4ED8"
                            TextColor="White"
                            FontAttributes="Bold"
                            CornerRadius="16"
                            HeightRequest="54" />

                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
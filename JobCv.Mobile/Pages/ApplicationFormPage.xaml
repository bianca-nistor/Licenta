<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="JobCv.Mobile.Pages.ApplicationFormPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#F8FAFC">

    <ScrollView>
        <VerticalStackLayout Padding="24"
                             Spacing="20">

            <Grid ColumnDefinitions="*"
                  Margin="0,24,0,0">


                <VerticalStackLayout Grid.Column="0"
                                     Spacing="4">

                    <Label Text="Track application"
                           FontSize="32"
                           FontAttributes="Bold"
                           TextColor="#0F172A" />

                    <Label Text="Save this job and keep notes about your application process."
                           FontSize="14"
                           TextColor="#64748B" />
                </VerticalStackLayout>
            </Grid>

            <Border BackgroundColor="White"
                    Stroke="#E2E8F0"
                    StrokeShape="RoundRectangle 26"
                    Padding="20">

                <VerticalStackLayout Spacing="14">

                    <Label Text="Job information"
                           FontSize="22"
                           FontAttributes="Bold"
                           TextColor="#0F172A" />

                    <Entry x:Name="JobTitleEntry"
                           Placeholder="Job title"
                           BackgroundColor="#F8FAFC"
                           TextColor="#0F172A" />

                    <Entry x:Name="CompanyEntry"
                           Placeholder="Company"
                           BackgroundColor="#F8FAFC"
                           TextColor="#0F172A" />

                    <Entry x:Name="LocationEntry"
                           Placeholder="Location"
                           BackgroundColor="#F8FAFC"
                           TextColor="#0F172A" />

                    <Entry x:Name="JobUrlEntry"
                           Placeholder="Job URL"
                           Keyboard="Url"
                           BackgroundColor="#F8FAFC"
                           TextColor="#0F172A" />

                    <Entry x:Name="SourceEntry"
                           Placeholder="Source"
                           BackgroundColor="#F8FAFC"
                           TextColor="#0F172A" />

                </VerticalStackLayout>
            </Border>

            <Border BackgroundColor="White"
                    Stroke="#E2E8F0"
                    StrokeShape="RoundRectangle 26"
                    Padding="20">

                <VerticalStackLayout Spacing="14">

                    <Label Text="Application details"
                           FontSize="22"
                           FontAttributes="Bold"
                           TextColor="#0F172A" />

                    <Label Text="Status"
                           FontAttributes="Bold"
                           TextColor="#0F172A" />

                    <Picker x:Name="StatusPicker"
        Title="Choose status"
        BackgroundColor="#F8FAFC"
        TextColor="#0F172A"
        TitleColor="#64748B">

                        <Picker.Items>
                            <x:String>Saved</x:String>
                            <x:String>Applied</x:String>
                            <x:String>Interview Scheduled</x:String>
                            <x:String>Interview Done</x:String>
                            <x:String>Offer</x:String>
                            <x:String>Rejected</x:String>
                        </Picker.Items>

                    </Picker>

                    <Label Text="CV used"
                           FontAttributes="Bold"
                           TextColor="#0F172A" />

                    <Picker x:Name="CvPicker"
                            ItemDisplayBinding="{Binding Title}"
                            BackgroundColor="#F8FAFC"
                            TextColor="#0F172A" />

                    <Border BackgroundColor="#F8FAFC"
                            Stroke="#E2E8F0"
                            StrokeShape="RoundRectangle 18"
                            Padding="14">

                        <VerticalStackLayout Spacing="8">

                            <HorizontalStackLayout Spacing="8">
                                <CheckBox x:Name="UseAppliedDateCheckBox"
                                          Color="#1D4ED8"
                                          CheckedChanged="OnUseAppliedDateChanged" />

                                <Label Text="Add applied date"
                                       TextColor="#0F172A"
                                       VerticalOptions="Center" />
                            </HorizontalStackLayout>

                            <DatePicker x:Name="AppliedDatePicker"
                                        IsEnabled="False"
                                        BackgroundColor="White"
                                        TextColor="#0F172A" />
                        </VerticalStackLayout>
                    </Border>

                    <Border BackgroundColor="#F8FAFC"
                            Stroke="#E2E8F0"
                            StrokeShape="RoundRectangle 18"
                            Padding="14">

                        <VerticalStackLayout Spacing="8">

                            <HorizontalStackLayout Spacing="8">
                                <CheckBox x:Name="UseInterviewDateCheckBox"
                                          Color="#1D4ED8"
                                          CheckedChanged="OnUseInterviewDateChanged" />

                                <Label Text="Add interview date"
                                       TextColor="#0F172A"
                                       VerticalOptions="Center" />
                            </HorizontalStackLayout>

                            <DatePicker x:Name="InterviewDatePicker"
                                        IsEnabled="False"
                                        BackgroundColor="White"
                                        TextColor="#0F172A" />
                        </VerticalStackLayout>
                    </Border>

                    <Entry x:Name="SalaryRangeEntry"
                           Placeholder="Salary range optional"
                           BackgroundColor="#F8FAFC"
                           TextColor="#0F172A" />

                    <Entry x:Name="ContactPersonEntry"
                           Placeholder="Contact person optional"
                           BackgroundColor="#F8FAFC"
                           TextColor="#0F172A" />

                </VerticalStackLayout>
            </Border>

            <Border BackgroundColor="White"
                    Stroke="#E2E8F0"
                    StrokeShape="RoundRectangle 26"
                    Padding="20">

                <VerticalStackLayout Spacing="14">

                    <Label Text="Notes"
                           FontSize="22"
                           FontAttributes="Bold"
                           TextColor="#0F172A" />

                    <Editor x:Name="NotesEditor"
                            Placeholder="General notes about this job or application..."
                            BackgroundColor="#F8FAFC"
                            TextColor="#0F172A"
                            HeightRequest="120" />

                    <Editor x:Name="InterviewNotesEditor"
                            Placeholder="Interview notes, questions, feedback..."
                            BackgroundColor="#F8FAFC"
                            TextColor="#0F172A"
                            HeightRequest="120" />

                </VerticalStackLayout>
            </Border>

            <Label x:Name="MessageLabel"
                   Text=""
                   FontSize="13"
                   TextColor="#DC2626"
                   HorizontalTextAlignment="Center" />

            <Button Text="Save application"
                    Clicked="OnSaveClicked"
                    BackgroundColor="#1D4ED8"
                    TextColor="White"
                    FontAttributes="Bold"
                    CornerRadius="16"
                    HeightRequest="56"
                    Margin="0,0,0,30" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
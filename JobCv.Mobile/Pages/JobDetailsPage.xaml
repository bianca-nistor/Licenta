<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="JobCv.Mobile.Pages.JobDetailsPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#F1F5F9">

    <ScrollView>
        <VerticalStackLayout Padding="24"
                             Spacing="20">

            <!-- Header -->
            <Grid ColumnDefinitions="*"
                  ColumnSpacing="14"
                  Margin="0,30,0,0">


                <VerticalStackLayout Grid.Column="0"
                                     Spacing="4">

                    <Label Text="Job Details"
                           FontSize="34"
                           FontAttributes="Bold"
                           TextColor="#0F172A"
                           LineBreakMode="WordWrap" />

                    <Label Text="Review the job, prepare your CV and track your application."
                           FontSize="15"
                           TextColor="#64748B"
                           LineBreakMode="WordWrap" />

                </VerticalStackLayout>
            </Grid>

            <!-- Job information -->
            <Border BackgroundColor="White"
                    Stroke="#E2E8F0"
                    StrokeShape="RoundRectangle 28"
                    Padding="22">

                <VerticalStackLayout Spacing="14">

                    <Grid ColumnDefinitions="*,Auto"
                          ColumnSpacing="12">

                        <VerticalStackLayout Spacing="5">

                            <Label x:Name="TitleLabel"
                                   FontSize="28"
                                   FontAttributes="Bold"
                                   TextColor="#0F172A"
                                   LineBreakMode="WordWrap" />

                            <Label x:Name="CompanyLabel"
                                   FontSize="17"
                                   TextColor="#334155"
                                   LineBreakMode="WordWrap" />

                            <Label x:Name="LocationLabel"
                                   FontSize="15"
                                   TextColor="#64748B"
                                   LineBreakMode="WordWrap" />

                        </VerticalStackLayout>

                        <Border Grid.Column="1"
                                BackgroundColor="#EFF6FF"
                                Stroke="#BFDBFE"
                                StrokeShape="RoundRectangle 16"
                                Padding="12,8"
                                VerticalOptions="Start">

                            <Label x:Name="SourceLabel"
                                   FontSize="12"
                                   FontAttributes="Bold"
                                   TextColor="#1D4ED8" />

                        </Border>
                    </Grid>

                    <Grid ColumnDefinitions="*,*"
                          ColumnSpacing="10">

                        <Border BackgroundColor="#F8FAFC"
                                Stroke="#E2E8F0"
                                StrokeShape="RoundRectangle 18"
                                Padding="14">

                            <VerticalStackLayout Spacing="4">

                                <Label Text="Salary"
                                       FontSize="12"
                                       TextColor="#64748B" />

                                <Label x:Name="SalaryLabel"
                                       FontSize="15"
                                       FontAttributes="Bold"
                                       TextColor="#0F172A"
                                       LineBreakMode="WordWrap" />

                            </VerticalStackLayout>
                        </Border>

                        <Border Grid.Column="1"
                                BackgroundColor="#F8FAFC"
                                Stroke="#E2E8F0"
                                StrokeShape="RoundRectangle 18"
                                Padding="14">

                            <VerticalStackLayout Spacing="4">

                                <Label Text="Posted"
                                       FontSize="12"
                                       TextColor="#64748B" />

                                <Label x:Name="PostedLabel"
                                       FontSize="15"
                                       FontAttributes="Bold"
                                       TextColor="#0F172A"
                                       LineBreakMode="WordWrap" />

                            </VerticalStackLayout>
                        </Border>
                    </Grid>

                    <BoxView HeightRequest="1"
                             Color="#E2E8F0" />

                    <Label Text="Description"
                           FontSize="21"
                           FontAttributes="Bold"
                           TextColor="#0F172A" />

                    <Label x:Name="DescriptionLabel"
                           FontSize="15"
                           TextColor="#475569"
                           LineBreakMode="WordWrap" />
                    <Button Text="View full job post"
        Clicked="OnViewFullJobPostClicked"
        BackgroundColor="#EFF6FF"
        TextColor="#1D4ED8"
        BorderColor="#93C5FD"
        BorderWidth="1"
        FontAttributes="Bold"
        CornerRadius="14"
        HeightRequest="46"
        Margin="0,6,0,0" />

                </VerticalStackLayout>
            </Border>

            <!-- Actions -->
            <Border BackgroundColor="#0F172A"
                    Stroke="#0F172A"
                    StrokeShape="RoundRectangle 28"
                    Padding="20">

                <VerticalStackLayout Spacing="14">

                    <Label Text="Actions"
                           FontSize="23"
                           FontAttributes="Bold"
                           TextColor="White" />

                    <Label Text="Choose what you want to do with this job."
                           FontSize="14"
                           TextColor="#CBD5E1"
                           LineBreakMode="WordWrap" />

                    <Grid ColumnDefinitions="*,*"
      RowDefinitions="Auto,Auto,Auto,Auto"
      ColumnSpacing="12"
      RowSpacing="12">

                        <Button Text="Apply"
            Clicked="OnApplyClicked"
            BackgroundColor="#1D4ED8"
            FontSize="13"
            FontAutoScalingEnabled="False"
            TextColor="White"
            FontAttributes="Bold"
            CornerRadius="16"
            HeightRequest="54"
            HorizontalOptions="Fill" />

                        <Button Grid.Column="1"
            Text="Create CV"
            Clicked="OnCreateCvClicked"
            BackgroundColor="#2563EB"
            FontSize="13"
            FontAutoScalingEnabled="False"
            TextColor="White"
            FontAttributes="Bold"
            CornerRadius="16"
            HeightRequest="54"
            HorizontalOptions="Fill" />

                        <Button Grid.Row="1"
            Text="Tailor CV"
            Clicked="OnTailorCvClicked"
            BackgroundColor="#16A34A"
            FontSize="13"
            FontAutoScalingEnabled="False"
            TextColor="White"
            FontAttributes="Bold"
            CornerRadius="16"
            HeightRequest="54"
            HorizontalOptions="Fill" />

                        <Button Grid.Row="1"
            Grid.Column="1"
            Text="Interview Prep"
            Clicked="OnPrepareInterviewClicked"
            BackgroundColor="#15803D"
            FontSize="13"
            FontAutoScalingEnabled="False"
            TextColor="White"
            FontAttributes="Bold"
            CornerRadius="16"
            HeightRequest="54"
            HorizontalOptions="Fill" />

                        <Button Grid.Row="2"
            Text="AI Match"
            Clicked="OnMatchScoreClicked"
            BackgroundColor="#7C3AED"
            FontSize="13"
            FontAutoScalingEnabled="False"
            TextColor="White"
            FontAttributes="Bold"
            CornerRadius="16"
            HeightRequest="54"
            HorizontalOptions="Fill" />

                        <Button Grid.Row="2"
            Grid.Column="1"
            Text="Save Job"
            Clicked="OnSaveJobClicked"
            BackgroundColor="#EFF6FF"
            FontSize="13"
            FontAutoScalingEnabled="False"
            TextColor="#1D4ED8"
            BorderColor="#93C5FD"
            BorderWidth="1"
            FontAttributes="Bold"
            CornerRadius="16"
            HeightRequest="54"
            HorizontalOptions="Fill" />

                        <Button Grid.Row="3"
            Grid.ColumnSpan="2"
            Text="Track Application"
            Clicked="OnTrackApplicationClicked"
            BackgroundColor="#F3E8FF"
            FontSize="13"
            FontAutoScalingEnabled="False"
            TextColor="#6D28D9"
            BorderColor="#C4B5FD"
            BorderWidth="1"
            FontAttributes="Bold"
            CornerRadius="16"
            HeightRequest="54"
            HorizontalOptions="Fill" />

                    </Grid>

                    <Label x:Name="MessageLabel"
                           Text=""
                           FontSize="13"
                           TextColor="#CBD5E1"
                           LineBreakMode="WordWrap" />

                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
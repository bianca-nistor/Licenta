<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="JobCv.Mobile.Pages.CreateCvPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#F8FAFC">

    <ScrollView>
        <VerticalStackLayout Padding="22,22,22,28"
                             Spacing="18">

            <!-- Header -->
            <Grid ColumnDefinitions="Auto,*"
                  ColumnSpacing="14"
                  Margin="0,18,0,6"
                  VerticalOptions="Start">

                <Button Text="←"
                        Clicked="OnBackClicked"
                        BackgroundColor="#E2E8F0"
                        TextColor="#0F172A"
                        FontSize="18"
                        CornerRadius="18"
                        WidthRequest="44"
                        HeightRequest="44"
                        Padding="0" />

                <VerticalStackLayout Grid.Column="1"
                                     Spacing="3"
                                     VerticalOptions="Center">

                    <Label Text="Create CV"
                           FontSize="34"
                           FontAttributes="Bold"
                           TextColor="#0F172A"
                           LineBreakMode="NoWrap"
                           MaxLines="1" />

                    <Label Text="Choose how you want to start your CV."
                           FontSize="15"
                           TextColor="#64748B"
                           LineBreakMode="WordWrap" />
                </VerticalStackLayout>
            </Grid>

            <!-- Start from scratch -->
            <Border BackgroundColor="White"
                    Stroke="#E2E8F0"
                    StrokeShape="RoundRectangle 26"
                    Padding="22">

                <VerticalStackLayout Spacing="14">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Start from scratch"
                               FontSize="25"
                               FontAttributes="Bold"
                               TextColor="#0F172A"
                               LineBreakMode="WordWrap" />

                        <Label Text="Create a new CV and add your personal information, photo, skills, education, experience and projects."
                               FontSize="15"
                               TextColor="#64748B"
                               LineHeight="1.15"
                               LineBreakMode="WordWrap" />
                    </VerticalStackLayout>

                    <Button Text="Start"
                            Clicked="OnStartFromScratchClicked"
                            BackgroundColor="#1D4ED8"
                            TextColor="White"
                            FontAttributes="Bold"
                            FontSize="16"
                            CornerRadius="16"
                            HeightRequest="56"
                            HorizontalOptions="Fill" />
                </VerticalStackLayout>
            </Border>

            <!-- Duplicate existing CV -->
            <Border BackgroundColor="White"
                    Stroke="#E2E8F0"
                    StrokeShape="RoundRectangle 26"
                    Padding="22">

                <VerticalStackLayout Spacing="14">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Duplicate existing CV"
                               FontSize="25"
                               FontAttributes="Bold"
                               TextColor="#0F172A"
                               LineBreakMode="WordWrap" />

                        <Label Text="Create a new version based on one of your existing CVs."
                               FontSize="15"
                               TextColor="#64748B"
                               LineHeight="1.15"
                               LineBreakMode="WordWrap" />
                    </VerticalStackLayout>

                    <Button Text="Choose"
                            Clicked="OnDuplicateCvClicked"
                            BackgroundColor="#DCFCE7"
                            TextColor="#166534"
                            FontAttributes="Bold"
                            FontSize="16"
                            CornerRadius="16"
                            HeightRequest="56"
                            HorizontalOptions="Fill" />
                </VerticalStackLayout>
            </Border>

            <!-- Upload existing CV -->
            <Border BackgroundColor="White"
                    Stroke="#E2E8F0"
                    StrokeShape="RoundRectangle 26"
                    Padding="22">

                <VerticalStackLayout Spacing="14">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Upload existing CV"
                               FontSize="25"
                               FontAttributes="Bold"
                               TextColor="#0F172A"
                               LineBreakMode="WordWrap" />

                        <Label Text="Upload an existing PDF, DOC or DOCX CV and keep it in your CV library."
                               FontSize="15"
                               TextColor="#64748B"
                               LineHeight="1.15"
                               LineBreakMode="WordWrap" />
                    </VerticalStackLayout>

                    <Button Text="Upload"
                            Clicked="OnUploadCvClicked"
                            BackgroundColor="#DCFCE7"
                            TextColor="#166534"
                            FontAttributes="Bold"
                            FontSize="16"
                            CornerRadius="16"
                            HeightRequest="56"
                            HorizontalOptions="Fill" />
                </VerticalStackLayout>
            </Border>

            <Label x:Name="MessageLabel"
                   Text=""
                   FontSize="13"
                   TextColor="#DC2626"
                   HorizontalTextAlignment="Center" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>

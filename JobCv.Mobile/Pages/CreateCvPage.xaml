<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="JobCv.Mobile.Pages.CreateCvPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#F8FAFC">

    <ScrollView>
        <VerticalStackLayout Padding="24"
                             Spacing="22">

            <!-- Header -->
            <Grid ColumnDefinitions="Auto,*"
                  Margin="0,30,0,0">

                <Button Text="←"
                        Clicked="OnBackClicked"
                        BackgroundColor="#E2E8F0"
                        TextColor="#0F172A"
                        CornerRadius="18"
                        WidthRequest="44"
                        HeightRequest="44" />

                <VerticalStackLayout Grid.Column="1"
                                     Margin="14,0,0,0"
                                     Spacing="4">

                    <Label Text="Create CV"
                           FontSize="34"
                           FontAttributes="Bold"
                           TextColor="#0F172A" />

                    <Label Text="Choose how you want to start your CV."
                           FontSize="14"
                           TextColor="#64748B" />
                </VerticalStackLayout>
            </Grid>

            <!-- Start from scratch -->
            <Border BackgroundColor="White"
                    Stroke="#E2E8F0"
                    StrokeShape="RoundRectangle 26"
                    Padding="22">

                <Grid ColumnDefinitions="*,Auto"
                      ColumnSpacing="18">

                    <VerticalStackLayout Spacing="6">
                        <Label Text="Start from scratch"
                               FontSize="24"
                               FontAttributes="Bold"
                               TextColor="#0F172A" />

                        <Label Text="Create a new CV and add your personal information, photo, skills, education, experience and projects."
                               FontSize="14"
                               TextColor="#64748B"
                               LineBreakMode="WordWrap" />
                    </VerticalStackLayout>

                    <Button Grid.Column="1"
                            Text="Start"
                            Clicked="OnStartFromScratchClicked"
                            BackgroundColor="#1D4ED8"
                            TextColor="White"
                            FontAttributes="Bold"
                            CornerRadius="16"
                            WidthRequest="130"
                            HeightRequest="58"
                            VerticalOptions="Center" />
                </Grid>
            </Border>

            <!-- Duplicate existing CV -->
            <Border BackgroundColor="White"
                    Stroke="#E2E8F0"
                    StrokeShape="RoundRectangle 26"
                    Padding="22">

                <Grid ColumnDefinitions="*,Auto"
                      ColumnSpacing="18">

                    <VerticalStackLayout Spacing="6">
                        <Label Text="Duplicate existing CV"
                               FontSize="24"
                               FontAttributes="Bold"
                               TextColor="#0F172A" />

                        <Label Text="Create a new version based on one of your existing CVs."
                               FontSize="14"
                               TextColor="#64748B"
                               LineBreakMode="WordWrap" />
                    </VerticalStackLayout>

                    <Button Grid.Column="1"
                            Text="Choose"
                            Clicked="OnDuplicateCvClicked"
                            BackgroundColor="#DCFCE7"
                            TextColor="#166534"
                            FontAttributes="Bold"
                            CornerRadius="16"
                            WidthRequest="130"
                            HeightRequest="58"
                            VerticalOptions="Center" />
                </Grid>
            </Border>

            <!-- Upload existing CV -->
            <Border BackgroundColor="White"
                    Stroke="#E2E8F0"
                    StrokeShape="RoundRectangle 26"
                    Padding="22">

                <Grid ColumnDefinitions="*,Auto"
                      ColumnSpacing="18">

                    <VerticalStackLayout Spacing="6">
                        <Label Text="Upload existing CV"
                               FontSize="24"
                               FontAttributes="Bold"
                               TextColor="#0F172A" />

                        <Label Text="Upload an existing PDF, DOC or DOCX CV and keep it in your CV library."
                               FontSize="14"
                               TextColor="#64748B"
                               LineBreakMode="WordWrap" />
                    </VerticalStackLayout>

                    <Button Grid.Column="1"
                            Text="Upload"
                            Clicked="OnUploadCvClicked"
                            BackgroundColor="#DCFCE7"
                            TextColor="#166534"
                            FontAttributes="Bold"
                            CornerRadius="16"
                            WidthRequest="130"
                            HeightRequest="58"
                            VerticalOptions="Center" />
                </Grid>
            </Border>

            <Label x:Name="MessageLabel"
                   Text=""
                   FontSize="13"
                   TextColor="#DC2626"
                   HorizontalTextAlignment="Center" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
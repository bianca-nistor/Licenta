<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="JobCv.Mobile.Pages.CreateCvPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#F8FAFC">

    <ContentPage.Resources>
        <Style TargetType="Label">
            <Setter Property="FontAutoScalingEnabled" Value="False" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="FontAutoScalingEnabled" Value="False" />
        </Style>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="22,16,22,28"
                             Spacing="14"
                             HorizontalOptions="Center"
                             MaximumWidthRequest="620">

            <!-- Header -->
            <VerticalStackLayout Spacing="4"
                                 Margin="0,8,0,4">

                <Label Text="Create CV"
                       FontSize="31"
                       FontAttributes="Bold"
                       TextColor="#0F172A"
                       LineBreakMode="NoWrap"
                       MaxLines="1" />

                <Label Text="Choose how you want to start your CV."
                       FontSize="14"
                       TextColor="#64748B"
                       LineBreakMode="WordWrap"
                       MaxLines="2" />
            </VerticalStackLayout>

            <!-- Start from scratch -->
            <Border BackgroundColor="White"
                    Stroke="#E2E8F0"
                    StrokeShape="RoundRectangle 24"
                    Padding="20">

                <VerticalStackLayout Spacing="12">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Start from scratch"
                               FontSize="22"
                               FontAttributes="Bold"
                               TextColor="#0F172A"
                               LineBreakMode="WordWrap"
                               MaxLines="2" />

                        <Label Text="Create a new CV and add your personal information, photo, skills, education, experience and projects."
                               FontSize="14"
                               TextColor="#64748B"
                               LineHeight="1.12"
                               LineBreakMode="WordWrap" />
                    </VerticalStackLayout>

                    <Button Text="Start"
                            Clicked="OnStartFromScratchClicked"
                            BackgroundColor="#1D4ED8"
                            TextColor="White"
                            FontAttributes="Bold"
                            FontSize="15"
                            CornerRadius="15"
                            HeightRequest="50"
                            HorizontalOptions="Fill" />
                </VerticalStackLayout>
            </Border>

            <!-- Duplicate existing CV -->
            <Border BackgroundColor="White"
                    Stroke="#E2E8F0"
                    StrokeShape="RoundRectangle 24"
                    Padding="20">

                <VerticalStackLayout Spacing="12">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Duplicate existing CV"
                               FontSize="22"
                               FontAttributes="Bold"
                               TextColor="#0F172A"
                               LineBreakMode="WordWrap"
                               MaxLines="2" />

                        <Label Text="Create a new version based on one of your existing CVs."
                               FontSize="14"
                               TextColor="#64748B"
                               LineHeight="1.12"
                               LineBreakMode="WordWrap" />
                    </VerticalStackLayout>

                    <Button Text="Choose"
                            Clicked="OnDuplicateCvClicked"
                            BackgroundColor="#DCFCE7"
                            TextColor="#166534"
                            FontAttributes="Bold"
                            FontSize="15"
                            CornerRadius="15"
                            HeightRequest="50"
                            HorizontalOptions="Fill" />
                </VerticalStackLayout>
            </Border>

            <!-- Start from your CV -->
            <Border BackgroundColor="White"
                    Stroke="#E2E8F0"
                    StrokeShape="RoundRectangle 24"
                    Padding="20">

                <VerticalStackLayout Spacing="12">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Start from your CV"
                               FontSize="22"
                               FontAttributes="Bold"
                               TextColor="#0F172A"
                               LineBreakMode="WordWrap"
                               MaxLines="2" />

                        <Label Text="Upload a PDF CV and we’ll copy the information we can find into a new editable CV."
                               FontSize="14"
                               TextColor="#64748B"
                               LineHeight="1.12"
                               LineBreakMode="WordWrap" />
                    </VerticalStackLayout>

                    <Button Text="Extract information"
                            Clicked="OnStartFromYourCvClicked"
                            BackgroundColor="#DCFCE7"
                            TextColor="#166534"
                            FontAttributes="Bold"
                            FontSize="15"
                            CornerRadius="15"
                            HeightRequest="50"
                            HorizontalOptions="Fill" />
                </VerticalStackLayout>
            </Border>

            <!-- Upload existing CV -->
            <Border BackgroundColor="White"
                    Stroke="#E2E8F0"
                    StrokeShape="RoundRectangle 24"
                    Padding="20">

                <VerticalStackLayout Spacing="12">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Upload existing CV"
                               FontSize="22"
                               FontAttributes="Bold"
                               TextColor="#0F172A"
                               LineBreakMode="WordWrap"
                               MaxLines="2" />

                        <Label Text="Upload an existing PDF, DOC or DOCX CV and keep it in your CV library."
                               FontSize="14"
                               TextColor="#64748B"
                               LineHeight="1.12"
                               LineBreakMode="WordWrap" />
                    </VerticalStackLayout>

                    <Button Text="Upload"
                            Clicked="OnUploadCvClicked"
                            BackgroundColor="#DCFCE7"
                            TextColor="#166534"
                            FontAttributes="Bold"
                            FontSize="15"
                            CornerRadius="15"
                            HeightRequest="50"
                            HorizontalOptions="Fill" />
                </VerticalStackLayout>
            </Border>

            <Label x:Name="MessageLabel"
                   Text=""
                   FontSize="13"
                   TextColor="#DC2626"
                   HorizontalTextAlignment="Center"
                   LineBreakMode="WordWrap" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>

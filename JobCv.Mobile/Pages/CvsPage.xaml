<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="JobCv.Mobile.Pages.CvsPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#F1F5F9">

    <ScrollView>
        <VerticalStackLayout Padding="24"
                             Spacing="22">

            <!-- Header -->
            <Grid ColumnDefinitions="Auto,*,Auto"
      ColumnSpacing="14"
      Margin="0,30,0,0">

                <Button Grid.Column="0"
            Text="☰"
            Clicked="OnMenuClicked"
            BackgroundColor="#E2E8F0"
            TextColor="#0F172A"
            CornerRadius="18"
            WidthRequest="48"
            HeightRequest="48"
            FontSize="22"
            VerticalOptions="Start" />

                <VerticalStackLayout Grid.Column="1"
                         Spacing="4">

                    <Label x:Name="PageTitleLabel"
       Text="Career Dashboard"
       FontSize="34"
       FontAttributes="Bold"
       TextColor="#0F172A"
       MaxLines="1"
       LineBreakMode="NoWrap"
       HorizontalOptions="Start"                     
       />
                    <Label x:Name="WelcomeLabel"
               Text=""
               FontSize="16"
               TextColor="#64748B"
               LineBreakMode="WordWrap" />
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="2"
                         HorizontalOptions="End"
                         VerticalOptions="Start"
                         Spacing="8">

                    <Button Text="👤"
                Clicked="OnProfileClicked"
                BackgroundColor="#DCFCE7"
                TextColor="#0F172A"
                CornerRadius="22"
                WidthRequest="48"
                HeightRequest="48"
                FontSize="18" />

                    <Border x:Name="ProfileMenu"
                IsVisible="False"
                BackgroundColor="White"
                Stroke="#E2E8F0"
                StrokeShape="RoundRectangle 18"
                Padding="12"
                WidthRequest="210"
                Shadow="5,5,12,#22000000">

                        <VerticalStackLayout Spacing="8">

                            <Label Text="Profile"
                       FontSize="18"
                       FontAttributes="Bold"
                       TextColor="#0F172A"
                       Margin="4,0,4,6" />

                            <Button Text="View profile"
                        Clicked="OnViewProfileClicked"
                        BackgroundColor="#EFF6FF"
                        TextColor="#1D4ED8"
                        CornerRadius="12"
                        HeightRequest="44" />

                            <Button Text="Logout"
                        Clicked="OnLogoutClicked"
                        BackgroundColor="#FEE2E2"
                        TextColor="#DC2626"
                        CornerRadius="12"
                        HeightRequest="44" />

                        </VerticalStackLayout>
                    </Border>

                </VerticalStackLayout>
            </Grid>
            <!-- Hamburger menu -->
            <Border x:Name="MainMenu"
        IsVisible="False"
        BackgroundColor="White"
        Stroke="#E2E8F0"
        StrokeShape="RoundRectangle 22"
        Padding="14"
        Shadow="5,5,12,#22000000">

                <VerticalStackLayout Spacing="10">

                    <Label Text="Menu"
               FontSize="18"
               FontAttributes="Bold"
               TextColor="#0F172A"
               Margin="4,0,4,4" />

                    <Button Text="Dashboard"
                Clicked="OnDashboardClicked"
                BackgroundColor="#1D4ED8"
                TextColor="White"
                FontAttributes="Bold"
                CornerRadius="14"
                HeightRequest="46" />

                    <Button Text="My CVs"
                Clicked="OnMyCvsClicked"
                BackgroundColor="#EFF6FF"
                TextColor="#1D4ED8"
                FontAttributes="Bold"
                CornerRadius="14"
                HeightRequest="46" />

                    <Button Text="Applications"
                Clicked="OnMyApplicationsClicked"
                BackgroundColor="#EFF6FF"
                TextColor="#1D4ED8"
                FontAttributes="Bold"
                CornerRadius="14"
                HeightRequest="46" />

                    <Button Text="Jobs"
                Clicked="OnFindJobsClicked"
                BackgroundColor="#EFF6FF"
                TextColor="#1D4ED8"
                FontAttributes="Bold"
                CornerRadius="14"
                HeightRequest="46" />

                </VerticalStackLayout>
            </Border>

            <!-- Overview stats -->
            <VerticalStackLayout Spacing="10">

                <Label Text="Overview"
                       FontSize="24"
                       FontAttributes="Bold"
                       TextColor="#0F172A"
                       Margin="0,8,0,0" />

                <Grid ColumnDefinitions="*,*"
                      RowDefinitions="Auto,Auto"
                      ColumnSpacing="12"
                      RowSpacing="12">

                    <Border BackgroundColor="White"
                            Stroke="#E2E8F0"
                            StrokeShape="RoundRectangle 22"
                            Padding="16">

                        <VerticalStackLayout Spacing="4">
                            <Label x:Name="CreatedCvCountLabel"
                                   Text="0"
                                   FontSize="26"
                                   FontAttributes="Bold"
                                   TextColor="#1D4ED8" />

                            <Label Text="Created CVs"
                                   FontSize="13"
                                   TextColor="#64748B" />
                        </VerticalStackLayout>
                    </Border>

                    <Border Grid.Column="1"
                            BackgroundColor="White"
                            Stroke="#E2E8F0"
                            StrokeShape="RoundRectangle 22"
                            Padding="16">

                        <VerticalStackLayout Spacing="4">
                            <Label x:Name="UploadedCvCountLabel"
                                   Text="0"
                                   FontSize="26"
                                   FontAttributes="Bold"
                                   TextColor="#166534" />

                            <Label Text="Uploaded CVs"
                                   FontSize="13"
                                   TextColor="#64748B" />
                        </VerticalStackLayout>
                    </Border>

                    <Border Grid.Row="1"
                            BackgroundColor="White"
                            Stroke="#E2E8F0"
                            StrokeShape="RoundRectangle 22"
                            Padding="16">

                        <VerticalStackLayout Spacing="4">
                            <Label x:Name="ApplicationsCountLabel"
                                   Text="0"
                                   FontSize="26"
                                   FontAttributes="Bold"
                                   TextColor="#7C3AED" />

                            <Label Text="Applications"
                                   FontSize="13"
                                   TextColor="#64748B" />
                        </VerticalStackLayout>
                    </Border>

                    <Border Grid.Row="1"
                            Grid.Column="1"
                            BackgroundColor="White"
                            Stroke="#E2E8F0"
                            StrokeShape="RoundRectangle 22"
                            Padding="16">

                        <VerticalStackLayout Spacing="4">
                            <Label x:Name="InterviewsCountLabel"
                                   Text="0"
                                   FontSize="26"
                                   FontAttributes="Bold"
                                   TextColor="#EA580C" />

                            <Label Text="Interviews"
                                   FontSize="13"
                                   TextColor="#64748B" />
                        </VerticalStackLayout>
                    </Border>

                </Grid>
            </VerticalStackLayout>

            <!-- Quick actions card -->
            <Border BackgroundColor="#0F172A"
                    Stroke="#0F172A"
                    StrokeShape="RoundRectangle 28"
                    Padding="22"
                    Margin="0,10,0,0">

                <VerticalStackLayout Spacing="16">

                    <VerticalStackLayout Spacing="6">
                        <Label Text="Prepare your next application"
                               FontSize="26"
                               FontAttributes="Bold"
                               TextColor="White" />

                        <Label Text="Create tailored CVs, search job opportunities and track your progress."
                               FontSize="14"
                               TextColor="#CBD5E1"
                               LineBreakMode="WordWrap" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="10">

                        <Button Text="Create new CV"
                                Clicked="OnCreateCvClicked"
                                BackgroundColor="#1D4ED8"
                                TextColor="White"
                                FontAttributes="Bold"
                                CornerRadius="16"
                                HeightRequest="54" />

                        <Button Text="Find jobs"
                                Clicked="OnFindJobsClicked"
                                BackgroundColor="#DCFCE7"
                                TextColor="#166534"
                                FontAttributes="Bold"
                                CornerRadius="16"
                                HeightRequest="54" />

                        <Button Text="My applications"
                                Clicked="OnMyApplicationsClicked"
                                BackgroundColor="#EFF6FF"
                                TextColor="#1D4ED8"
                                BorderColor="#93C5FD"
                                BorderWidth="1"
                                FontAttributes="Bold"
                                CornerRadius="16"
                                HeightRequest="54" />

                    </VerticalStackLayout>

                </VerticalStackLayout>
            </Border>

            <!-- Recent applications -->
            <VerticalStackLayout Spacing="8">

                <Grid ColumnDefinitions="*,Auto"
                      Margin="0,8,0,0">

                    <VerticalStackLayout Spacing="4">
                        <Label Text="Recent applications"
                               FontSize="24"
                               FontAttributes="Bold"
                               TextColor="#0F172A" />

                        <Label Text="Your latest tracked job applications."
                               FontSize="14"
                               TextColor="#64748B" />
                    </VerticalStackLayout>

                    <Button Grid.Column="1"
                            Text="View all"
                            Clicked="OnMyApplicationsClicked"
                            BackgroundColor="#EFF6FF"
                            TextColor="#1D4ED8"
                            BorderColor="#93C5FD"
                            BorderWidth="1"
                            CornerRadius="14"
                            HeightRequest="42"
                            WidthRequest="100"
                            VerticalOptions="Center" />
                </Grid>

                <Label x:Name="RecentApplicationsEmptyLabel"
                       Text="No applications tracked yet. Search jobs and save your first application."
                       FontSize="14"
                       TextColor="#64748B"
                       IsVisible="False" />

                <CollectionView x:Name="RecentApplicationsCollectionView"
                                SelectionMode="None">

                    <CollectionView.ItemTemplate>
                        <DataTemplate>

                            <Border BackgroundColor="#F0F7FF"
                                    Stroke="#BFDBFE"
                                    StrokeShape="RoundRectangle 22"
                                    Padding="16"
                                    Margin="0,0,0,10">

                                <VerticalStackLayout Spacing="8">

                                    <Grid ColumnDefinitions="*,Auto"
                                          ColumnSpacing="10">

                                        <VerticalStackLayout Spacing="3">
                                            <Label Text="{Binding JobTitle}"
                                                   FontSize="18"
                                                   FontAttributes="Bold"
                                                   TextColor="#0F172A" />

                                            <Label Text="{Binding Company}"
                                                   FontSize="14"
                                                   TextColor="#334155" />
                                        </VerticalStackLayout>

                                        <Border Grid.Column="1"
                                                BackgroundColor="White"
                                                Stroke="#DBEAFE"
                                                StrokeShape="RoundRectangle 14"
                                                Padding="10,6"
                                                VerticalOptions="Start">

                                            <Label Text="{Binding Status}"
                                                   FontSize="12"
                                                   TextColor="#1D4ED8"
                                                   FontAttributes="Bold" />
                                        </Border>
                                    </Grid>

                                    <Label Text="{Binding CvDisplay}"
                                           FontSize="13"
                                           TextColor="#64748B" />

                                </VerticalStackLayout>
                            </Border>

                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
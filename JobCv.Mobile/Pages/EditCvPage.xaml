<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="JobCv.Mobile.Pages.EditCvPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#F8FAFC">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="18">

            <!-- Header -->
            <Grid ColumnDefinitions="*" Margin="0,20,0,0">

                <VerticalStackLayout Grid.Column="0" Margin="14,0,0,0" Spacing="4">
                    <Label Text="Edit CV"
                           FontSize="32"
                           FontAttributes="Bold"
                           TextColor="#0F172A" />

                    <Label Text="Update your CV information and sections."
                           FontSize="14"
                           TextColor="#64748B" />
                </VerticalStackLayout>
            </Grid>

            <!-- CV Photo -->
            <Border BackgroundColor="White"
                    Stroke="#E2E8F0"
                    StrokeShape="RoundRectangle 26"
                    Padding="20">

                <VerticalStackLayout Spacing="16">

                    <Label Text="CV photo"
                           FontSize="22"
                           FontAttributes="Bold"
                           TextColor="#0F172A" />

                    <Grid ColumnDefinitions="Auto,*"
                          ColumnSpacing="16">

                        <Border x:Name="CvPhotoBorder"
                                WidthRequest="92"
                                HeightRequest="92"
                                Stroke="#BFDBFE"
                                StrokeThickness="2"
                                BackgroundColor="#EFF6FF"
                                StrokeShape="RoundRectangle 46"
                                IsVisible="False">

                            <Image x:Name="CvPhotoImage"
                                   Aspect="AspectFill"
                                   WidthRequest="92"
                                   HeightRequest="92" />
                        </Border>

                        <VerticalStackLayout Grid.Column="1"
                                             Spacing="8"
                                             VerticalOptions="Center">

                            <Label Text="Optional. Add a professional photo if you want it to appear in the CV header."
                                   FontSize="14"
                                   TextColor="#64748B" />

                            <Button Text="Choose photo"
                                    Clicked="OnChooseCvPhotoClicked"
                                    BackgroundColor="#DCFCE7"
                                    TextColor="#166534"
                                    FontAttributes="Bold"
                                    CornerRadius="16"
                                    HeightRequest="48" />

                            <Label x:Name="PhotoMessageLabel"
                                   Text=""
                                   FontSize="13"
                                   TextColor="#DC2626" />
                        </VerticalStackLayout>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Basic Info -->
            <Border BackgroundColor="White"
        Stroke="#E2E8F0"
        StrokeShape="RoundRectangle 26"
        Padding="20">

                <VerticalStackLayout Spacing="14">

                    <Label Text="Basic information"
               FontSize="22"
               FontAttributes="Bold"
               TextColor="#0F172A" />

                    <Entry x:Name="TitleEntry"
               Placeholder="CV title"
               BackgroundColor="#F8FAFC"
               TextColor="#0F172A"
               HeightRequest="50" />

                    <Entry x:Name="FullNameEntry"
               Placeholder="Full name"
               BackgroundColor="#F8FAFC"
               TextColor="#0F172A"
               HeightRequest="50" />

                    <Entry x:Name="EmailEntry"
               Placeholder="Email"
               Keyboard="Email"
               BackgroundColor="#F8FAFC"
               TextColor="#0F172A"
               HeightRequest="50" />

                    <Entry x:Name="PhoneEntry"
               Placeholder="Phone"
               Keyboard="Telephone"
               BackgroundColor="#F8FAFC"
               TextColor="#0F172A"
               HeightRequest="50" />

                    <Entry x:Name="LocationEntry"
               Placeholder="Location"
               BackgroundColor="#F8FAFC"
               TextColor="#0F172A"
               HeightRequest="50" />

                    <Entry x:Name="LinkedInEntry"
               Placeholder="LinkedIn URL"
               BackgroundColor="#F8FAFC"
               TextColor="#0F172A"
               HeightRequest="50" />

                    <Entry x:Name="GitHubEntry"
               Placeholder="GitHub URL"
               BackgroundColor="#F8FAFC"
               TextColor="#0F172A"
               HeightRequest="50" />

                    <Entry x:Name="PortfolioEntry"
               Placeholder="Portfolio URL"
               BackgroundColor="#F8FAFC"
               TextColor="#0F172A"
               HeightRequest="50" />

                    <Editor x:Name="SummaryEditor"
                Placeholder="Professional summary"
                BackgroundColor="#F8FAFC"
                TextColor="#0F172A"
                PlaceholderColor="#94A3B8"
                AutoSize="TextChanges"
                HeightRequest="110" />

                    <Label Text="CV language"
                           FontSize="14"
                           FontAttributes="Bold"
                           TextColor="#0F172A"
                           Margin="0,2,0,-8" />

                    <Picker x:Name="CvLanguagePicker"
        HeightRequest="56"
        MinimumHeightRequest="56"
        FontSize="16"
        VerticalOptions="Center"
        HorizontalOptions="Fill"
        BackgroundColor="#F8FAFC"
        TextColor="#0F172A" >
                        <Picker.Items>
                            <x:String>English</x:String>
                            <x:String>Romanian</x:String>
                        </Picker.Items>
                    </Picker>

                    <Picker x:Name="TemplatePicker"
                ItemDisplayBinding="{Binding Name}"
                SelectedIndexChanged="OnTemplateChanged"
                BackgroundColor="#F8FAFC"
                TextColor="#0F172A"
                TitleColor="#94A3B8"
                HeightRequest="52"
                Margin="0,4,0,12" />

                    <Grid>

                        <!-- Standard preview: Modern Blue, Green Professional, Warm Beige -->
                        <Border x:Name="TemplatePreviewBorder"
                    BackgroundColor="#F8FAFC"
                    Stroke="#CBD5E1"
                    StrokeShape="RoundRectangle 20"
                    Padding="16"
                    Margin="0,0,0,10">

                            <VerticalStackLayout Spacing="12">

                                <Label x:Name="TemplatePreviewTitleLabel"
                           Text="Template preview - Modern Blue"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="#0F172A" />

                                <Border x:Name="PreviewHeader"
                            BackgroundColor="#0F172A"
                            StrokeShape="RoundRectangle 16"
                            Padding="14">

                                    <Grid ColumnDefinitions="Auto,*"
                              ColumnSpacing="14">

                                        <Border x:Name="PreviewAvatar"
                                    BackgroundColor="#E2E8F0"
                                    StrokeShape="RoundRectangle 34"
                                    WidthRequest="64"
                                    HeightRequest="64">

                                            <Label x:Name="PreviewInitialsLabel"
                                       Text="MI"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"
                                       FontSize="20"
                                       FontAttributes="Bold"
                                       TextColor="#0F172A" />
                                        </Border>

                                        <VerticalStackLayout Grid.Column="1"
                                                 Spacing="3"
                                                 VerticalOptions="Center">

                                            <Label x:Name="PreviewNameLabel"
                                       Text="Maria Ionescu"
                                       FontSize="22"
                                       FontAttributes="Bold"
                                       TextColor="White" />

                                            <Label x:Name="PreviewRoleLabel"
                                       Text="Junior .NET Developer"
                                       FontSize="13"
                                       TextColor="#CBD5E1" />

                                            <Label x:Name="PreviewContactLabel"
                                       Text="maria@email.com | Bucharest"
                                       FontSize="10"
                                       TextColor="#CBD5E1" />
                                        </VerticalStackLayout>
                                    </Grid>
                                </Border>

                                <Grid ColumnDefinitions="*,*"
                          ColumnSpacing="18">

                                    <VerticalStackLayout Spacing="6">

                                        <Label x:Name="PreviewLeftTitleLabel"
                                   Text="Profile"
                                   FontAttributes="Bold"
                                   TextColor="#0F172A" />

                                        <BoxView x:Name="PreviewLeftLine"
                                     HeightRequest="1"
                                     BackgroundColor="#CBD5E1" />

                                        <Label x:Name="PreviewProfileTextLabel"
                                   Text="Organized junior developer interested in backend development and clean user experiences."
                                   FontSize="12"
                                   TextColor="#475569"
                                   LineBreakMode="WordWrap" />

                                        <Label x:Name="PreviewExperienceTitleLabel"
                                   Text="Experience"
                                   FontAttributes="Bold"
                                   TextColor="#0F172A"
                                   Margin="0,8,0,0" />

                                        <Label x:Name="PreviewExperienceTextLabel"
                                   Text="Intern Developer&#10;Worked with APIs, SQL queries and application testing."
                                   FontSize="12"
                                   TextColor="#475569"
                                   LineBreakMode="WordWrap" />
                                    </VerticalStackLayout>

                                    <VerticalStackLayout Grid.Column="1"
                                             Spacing="6">

                                        <Label x:Name="PreviewRightTitleLabel"
                                   Text="Skills"
                                   FontAttributes="Bold"
                                   TextColor="#0F172A" />

                                        <BoxView x:Name="PreviewRightLine"
                                     HeightRequest="1"
                                     BackgroundColor="#CBD5E1" />

                                        <Label x:Name="PreviewSkillsTextLabel"
                                   Text="C#&#10;ASP.NET Core&#10;SQL&#10;Git"
                                   FontSize="12"
                                   TextColor="#475569" />

                                        <Label x:Name="PreviewEducationTitleLabel"
                                   Text="Education"
                                   FontAttributes="Bold"
                                   TextColor="#0F172A"
                                   Margin="0,8,0,0" />

                                        <Label x:Name="PreviewEducationTextLabel"
                                   Text="BSc Computer Science&#10;2023 - 2026"
                                   FontSize="12"
                                   TextColor="#475569" />
                                    </VerticalStackLayout>
                                </Grid>
                            </VerticalStackLayout>
                        </Border>

                        <!-- Classic Minimal Preview -->
                        <Border x:Name="ClassicMinimalTemplatePreviewBorder"
                    IsVisible="False"
                    BackgroundColor="White"
                    Stroke="#CBD5E1"
                    StrokeShape="RoundRectangle 20"
                    Padding="18"
                    Margin="0,0,0,10">

                            <VerticalStackLayout Spacing="10">

                                <Label Text="Template preview - Classic Minimal"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="#0F172A" />

                                <Border BackgroundColor="White"
                            Stroke="#E5E7EB"
                            StrokeShape="RoundRectangle 16"
                            Padding="18">

                                    <VerticalStackLayout Spacing="10">

                                        <Label Text="Maria Ionescu"
                                   FontSize="26"
                                   FontAttributes="Bold"
                                   TextColor="#111827" />

                                        <Label Text="Junior .NET Developer"
                                   FontSize="13"
                                   TextColor="#4B5563" />

                                        <Label Text="maria@email.com | +40 700 000 000 | Bucharest"
                                   FontSize="10"
                                   TextColor="#6B7280" />

                                        <BoxView HeightRequest="1"
                                     BackgroundColor="#D1D5DB"
                                     Margin="0,4,0,8" />

                                        <Label Text="Professional Summary"
                                   FontSize="13"
                                   FontAttributes="Bold"
                                   TextColor="#111827" />

                                        <BoxView HeightRequest="1"
                                     BackgroundColor="#D1D5DB" />

                                        <Label Text="Motivated junior developer with knowledge of C#, SQL and REST APIs."
                                   FontSize="11"
                                   TextColor="#374151"
                                   LineBreakMode="WordWrap" />

                                        <Label Text="Skills"
                                   FontSize="13"
                                   FontAttributes="Bold"
                                   TextColor="#111827"
                                   Margin="0,8,0,0" />

                                        <BoxView HeightRequest="1"
                                     BackgroundColor="#D1D5DB" />

                                        <Label Text="C# • ASP.NET Core • SQL • Git"
                                   FontSize="11"
                                   TextColor="#374151" />

                                        <Label Text="Education"
                                   FontSize="13"
                                   FontAttributes="Bold"
                                   TextColor="#111827"
                                   Margin="0,8,0,0" />

                                        <BoxView HeightRequest="1"
                                     BackgroundColor="#D1D5DB" />

                                        <Label Text="BSc Computer Science&#10;2023 - 2026"
                                   FontSize="11"
                                   TextColor="#374151" />

                                    </VerticalStackLayout>
                                </Border>
                            </VerticalStackLayout>
                        </Border>

                        <!-- Blue Sidebar Preview -->
                        <Border x:Name="BlueSidebarTemplatePreviewBorder"
                    IsVisible="False"
                    BackgroundColor="#F8FAFC"
                    Stroke="#CBD5E1"
                    StrokeShape="RoundRectangle 20"
                    Padding="14"
                    Margin="0,0,0,10">

                            <VerticalStackLayout Spacing="12">

                                <Label Text="Template preview - Blue Sidebar"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="#0F172A"
                           LineBreakMode="WordWrap" />

                                <Border BackgroundColor="White"
                            Stroke="#E2E8F0"
                            StrokeShape="RoundRectangle 18"
                            Padding="0"
                            HorizontalOptions="Fill">

                                    <Grid ColumnDefinitions="96,*"
                              ColumnSpacing="0"
                              HeightRequest="420">

                                        <Border Grid.Column="0"
                                    BackgroundColor="#1D4ED8"
                                    StrokeThickness="0"
                                    Padding="10">

                                            <VerticalStackLayout Spacing="9">

                                                <Border BackgroundColor="#DBEAFE"
                                            Stroke="#BFDBFE"
                                            StrokeShape="RoundRectangle 24"
                                            WidthRequest="48"
                                            HeightRequest="48"
                                            HorizontalOptions="Center"
                                            Padding="0">

                                                    <Label Text="MI"
                                               TextColor="#1D4ED8"
                                               FontSize="16"
                                               FontAttributes="Bold"
                                               HorizontalTextAlignment="Center"
                                               VerticalTextAlignment="Center" />
                                                </Border>

                                                <Label Text="CONTACT"
                                           TextColor="White"
                                           FontSize="8"
                                           FontAttributes="Bold"
                                           Margin="0,4,0,0" />

                                                <Label Text="maria@email.com&#10;+40 700 000&#10;Bucharest"
                                           TextColor="#DBEAFE"
                                           FontSize="7"
                                           LineHeight="1.15"
                                           LineBreakMode="WordWrap" />

                                                <Label Text="SKILLS"
                                           TextColor="White"
                                           FontSize="8"
                                           FontAttributes="Bold"
                                           Margin="0,5,0,0" />

                                                <Label Text="C#&#10;SQL&#10;REST APIs&#10;Git"
                                           TextColor="#DBEAFE"
                                           FontSize="7"
                                           LineHeight="1.15"
                                           LineBreakMode="WordWrap" />

                                                <Label Text="LANGUAGES"
                                           TextColor="White"
                                           FontSize="8"
                                           FontAttributes="Bold"
                                           Margin="0,5,0,0" />

                                                <Label Text="Romanian&#10;English"
                                           TextColor="#DBEAFE"
                                           FontSize="7"
                                           LineHeight="1.15"
                                           LineBreakMode="WordWrap" />

                                            </VerticalStackLayout>
                                        </Border>

                                        <VerticalStackLayout Grid.Column="1"
                                                 Padding="12,14,10,10"
                                                 Spacing="7">

                                            <Label Text="Maria Ionescu"
                                       TextColor="#0F172A"
                                       FontSize="18"
                                       FontAttributes="Bold"
                                       LineBreakMode="TailTruncation"
                                       MaxLines="1" />

                                            <Label Text="Junior .NET Developer"
                                       TextColor="#1D4ED8"
                                       FontSize="10"
                                       FontAttributes="Bold"
                                       LineBreakMode="WordWrap"
                                       MaxLines="2" />

                                            <BoxView HeightRequest="1"
                                         BackgroundColor="#CBD5E1"
                                         Margin="0,2,0,3" />

                                            <Label Text="PROFILE"
                                       TextColor="#0F172A"
                                       FontSize="8"
                                       FontAttributes="Bold" />

                                            <Label Text="Motivated junior developer with knowledge of C#, SQL and REST APIs."
                                       TextColor="#475569"
                                       FontSize="8"
                                       LineHeight="1.15"
                                       LineBreakMode="WordWrap"
                                       MaxLines="4" />

                                            <Label Text="EXPERIENCE"
                                       TextColor="#0F172A"
                                       FontSize="8"
                                       FontAttributes="Bold"
                                       Margin="0,5,0,0" />

                                            <Label Text="Intern Developer"
                                       TextColor="#0F172A"
                                       FontSize="8"
                                       FontAttributes="Bold"
                                       LineBreakMode="WordWrap" />

                                            <Label Text="Built API features and tested database operations."
                                       TextColor="#475569"
                                       FontSize="8"
                                       LineHeight="1.15"
                                       LineBreakMode="WordWrap"
                                       MaxLines="4" />

                                            <Label Text="EDUCATION"
                                       TextColor="#0F172A"
                                       FontSize="8"
                                       FontAttributes="Bold"
                                       Margin="0,5,0,0" />

                                            <Label Text="BSc Computer Science"
                                       TextColor="#475569"
                                       FontSize="8"
                                       LineBreakMode="WordWrap"
                                       MaxLines="2" />

                                            <Label Text="PROJECTS"
                                       TextColor="#0F172A"
                                       FontSize="8"
                                       FontAttributes="Bold"
                                       Margin="0,5,0,0" />

                                            <Label Text="CV Builder App"
                                       TextColor="#475569"
                                       FontSize="8"
                                       LineBreakMode="WordWrap"
                                       MaxLines="2" />

                                        </VerticalStackLayout>
                                    </Grid>
                                </Border>
                            </VerticalStackLayout>
                        </Border>

                    </Grid>

                    <!-- Set as base CV -->
                    <Grid ColumnDefinitions="Auto,*"
              ColumnSpacing="10"
              Margin="0,2,0,0">

                    </Grid>

                    <Button Text="Save basic information"
                Clicked="OnSaveBasicInfoClicked"
                BackgroundColor="#1D4ED8"
                TextColor="White"
                FontAttributes="Bold"
                CornerRadius="16"
                HeightRequest="52" />

                    <Label x:Name="MessageLabel"
               Text=""
               FontSize="13"
               TextColor="#16A34A"
               HorizontalTextAlignment="Center" />

                </VerticalStackLayout>
            </Border>

            <!-- Skills -->
            <Border BackgroundColor="White" Stroke="#E2E8F0" StrokeShape="RoundRectangle 24" Padding="18">
                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Skills" FontSize="20" FontAttributes="Bold" TextColor="#0F172A" />
                        <Button Grid.Column="1" Text="+ Add" Clicked="OnAddSkillClicked"
                                BackgroundColor="#DCFCE7" TextColor="#166534" CornerRadius="14" />
                    </Grid>

                    <CollectionView x:Name="SkillsCollectionView" SelectionMode="None">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="*,Auto,Auto" Padding="0,6">
                                    <Label Text="{Binding Name}" TextColor="#0F172A" FontSize="15" />
                                    <Button Grid.Column="1" Text="Edit" Clicked="OnEditSkillClicked"
                                            CommandParameter="{Binding .}"
                                            BackgroundColor="#EFF6FF" TextColor="#1D4ED8" CornerRadius="12" />
                                    <Button Grid.Column="2" Text="Delete" Clicked="OnDeleteSkillClicked"
                                            CommandParameter="{Binding .}"
                                            BackgroundColor="#FEE2E2" TextColor="#DC2626" CornerRadius="12" />
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Border>

            <!-- Languages -->
            <Border BackgroundColor="White" Stroke="#E2E8F0" StrokeShape="RoundRectangle 24" Padding="18">
                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Languages" FontSize="20" FontAttributes="Bold" TextColor="#0F172A" />
                        <Button Grid.Column="1" Text="+ Add" Clicked="OnAddLanguageClicked"
                                BackgroundColor="#DCFCE7" TextColor="#166534" CornerRadius="14" />
                    </Grid>

                    <CollectionView x:Name="LanguagesCollectionView" SelectionMode="None">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="*,Auto,Auto" Padding="0,6">
                                    <Label Text="{Binding Name}" TextColor="#0F172A" FontSize="15" />
                                    <Button Grid.Column="1" Text="Edit" Clicked="OnEditLanguageClicked"
                                            CommandParameter="{Binding .}"
                                            BackgroundColor="#EFF6FF" TextColor="#1D4ED8" CornerRadius="12" />
                                    <Button Grid.Column="2" Text="Delete" Clicked="OnDeleteLanguageClicked"
                                            CommandParameter="{Binding .}"
                                            BackgroundColor="#FEE2E2" TextColor="#DC2626" CornerRadius="12" />
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Border>

            <!-- Education -->
            <Border BackgroundColor="White" Stroke="#E2E8F0" StrokeShape="RoundRectangle 24" Padding="18">
                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Education" FontSize="20" FontAttributes="Bold" TextColor="#0F172A" />
                        <Button Grid.Column="1" Text="+ Add" Clicked="OnAddEducationClicked"
                                BackgroundColor="#DCFCE7" TextColor="#166534" CornerRadius="14" />
                    </Grid>

                    <CollectionView x:Name="EducationsCollectionView" SelectionMode="None">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border BackgroundColor="#F8FAFC" Stroke="#E2E8F0" StrokeShape="RoundRectangle 16" Padding="12" Margin="0,0,0,8">
                                    <VerticalStackLayout Spacing="4">
                                        <Label Text="{Binding Degree}" FontAttributes="Bold" FontSize="15" TextColor="#0F172A" />
                                        <Label Text="{Binding Institution}" FontSize="13" TextColor="#64748B" />
                                        <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,6,0,0">
                                            <BoxView HeightRequest="1" BackgroundColor="#E2E8F0" VerticalOptions="Center" />
                                            <Button Grid.Column="1" Text="Edit" Clicked="OnEditEducationClicked" CommandParameter="{Binding .}"
                                                    BackgroundColor="#EFF6FF" TextColor="#1D4ED8" CornerRadius="12" />
                                            <Button Grid.Column="2" Text="Delete" Clicked="OnDeleteEducationClicked" CommandParameter="{Binding .}"
                                                    BackgroundColor="#FEE2E2" TextColor="#DC2626" CornerRadius="12" />
                                        </Grid>
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Border>

            <!-- Experience -->
            <Border BackgroundColor="White" Stroke="#E2E8F0" StrokeShape="RoundRectangle 24" Padding="18">
                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Experience" FontSize="20" FontAttributes="Bold" TextColor="#0F172A" />
                        <Button Grid.Column="1" Text="+ Add" Clicked="OnAddExperienceClicked"
                                BackgroundColor="#DCFCE7" TextColor="#166534" CornerRadius="14" />
                    </Grid>

                    <CollectionView x:Name="ExperiencesCollectionView" SelectionMode="None">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border BackgroundColor="#F8FAFC" Stroke="#E2E8F0" StrokeShape="RoundRectangle 16" Padding="12" Margin="0,0,0,8">
                                    <VerticalStackLayout Spacing="4">
                                        <Label Text="{Binding JobTitle}" FontAttributes="Bold" FontSize="15" TextColor="#0F172A" />
                                        <Label Text="{Binding Company}" FontSize="13" TextColor="#64748B" />
                                        <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,6,0,0">
                                            <BoxView HeightRequest="1" BackgroundColor="#E2E8F0" VerticalOptions="Center" />
                                            <Button Grid.Column="1" Text="Edit" Clicked="OnEditExperienceClicked" CommandParameter="{Binding .}"
                                                    BackgroundColor="#EFF6FF" TextColor="#1D4ED8" CornerRadius="12" />
                                            <Button Grid.Column="2" Text="Delete" Clicked="OnDeleteExperienceClicked" CommandParameter="{Binding .}"
                                                    BackgroundColor="#FEE2E2" TextColor="#DC2626" CornerRadius="12" />
                                        </Grid>
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Border>

            <!-- Projects -->
            <Border BackgroundColor="White" Stroke="#E2E8F0" StrokeShape="RoundRectangle 24" Padding="18">
                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Projects" FontSize="20" FontAttributes="Bold" TextColor="#0F172A" />
                        <Button Grid.Column="1" Text="+ Add" Clicked="OnAddProjectClicked"
                                BackgroundColor="#DCFCE7" TextColor="#166534" CornerRadius="14" />
                    </Grid>

                    <CollectionView x:Name="ProjectsCollectionView" SelectionMode="None">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border BackgroundColor="#F8FAFC" Stroke="#E2E8F0" StrokeShape="RoundRectangle 16" Padding="12" Margin="0,0,0,8">
                                    <VerticalStackLayout Spacing="4">
                                        <Label Text="{Binding Title}" FontAttributes="Bold" FontSize="15" TextColor="#0F172A" />
                                        <Label Text="{Binding Technologies}" FontSize="13" TextColor="#64748B" />
                                        <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,6,0,0">
                                            <BoxView HeightRequest="1" BackgroundColor="#E2E8F0" VerticalOptions="Center" />
                                            <Button Grid.Column="1" Text="Edit" Clicked="OnEditProjectClicked" CommandParameter="{Binding .}"
                                                    BackgroundColor="#EFF6FF" TextColor="#1D4ED8" CornerRadius="12" />
                                            <Button Grid.Column="2" Text="Delete" Clicked="OnDeleteProjectClicked" CommandParameter="{Binding .}"
                                                    BackgroundColor="#FEE2E2" TextColor="#DC2626" CornerRadius="12" />
                                        </Grid>
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Border>

            <!-- Certifications -->
            <Border BackgroundColor="White" Stroke="#E2E8F0" StrokeShape="RoundRectangle 24" Padding="18">
                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Certifications" FontSize="20" FontAttributes="Bold" TextColor="#0F172A" />
                        <Button Grid.Column="1" Text="+ Add" Clicked="OnAddCertificationClicked"
                                BackgroundColor="#DCFCE7" TextColor="#166534" CornerRadius="14" />
                    </Grid>

                    <CollectionView x:Name="CertificationsCollectionView" SelectionMode="None">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border BackgroundColor="#F8FAFC" Stroke="#E2E8F0" StrokeShape="RoundRectangle 16" Padding="12" Margin="0,0,0,8">
                                    <VerticalStackLayout Spacing="4">
                                        <Label Text="{Binding Name}" FontAttributes="Bold" FontSize="15" TextColor="#0F172A" />
                                        <Label Text="{Binding Issuer}" FontSize="13" TextColor="#64748B" />
                                        <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,6,0,0">
                                            <BoxView HeightRequest="1" BackgroundColor="#E2E8F0" VerticalOptions="Center" />
                                            <Button Grid.Column="1" Text="Edit" Clicked="OnEditCertificationClicked" CommandParameter="{Binding .}"
                                                    BackgroundColor="#EFF6FF" TextColor="#1D4ED8" CornerRadius="12" />
                                            <Button Grid.Column="2" Text="Delete" Clicked="OnDeleteCertificationClicked" CommandParameter="{Binding .}"
                                                    BackgroundColor="#FEE2E2" TextColor="#DC2626" CornerRadius="12" />
                                        </Grid>
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Border>

            <!-- Bottom save button -->
            <Border BackgroundColor="White"
                    Stroke="#E2E8F0"
                    StrokeShape="RoundRectangle 24"
                    Padding="18"
                    Margin="0,4,0,30">

                <VerticalStackLayout Spacing="12">

                    <Button Text="Save CV"
                            Clicked="OnSaveCvClicked"
                            BackgroundColor="#1D4ED8"
                            TextColor="White"
                            FontAttributes="Bold"
                            CornerRadius="16"
                            HeightRequest="56" />
                    <Button Text="My CVs"
        Clicked="OnGoToMyCvsClicked"
        BackgroundColor="#EFF6FF"
        TextColor="#1D4ED8"
        FontAttributes="Bold"
        CornerRadius="16"
        HeightRequest="52" />

                    <Label x:Name="BottomSaveMessageLabel"
                           Text=""
                           FontSize="13"
                           TextColor="#16A34A"
                           HorizontalTextAlignment="Center" />

                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>

<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="JobCv.Mobile.Pages.UploadedCvPreviewPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#F8FAFC">

    <Grid RowDefinitions="Auto,*"
          Padding="18">

        <Grid ColumnDefinitions="Auto,*,Auto"
              Margin="0,20,0,14">

            <Button Text="←"
                    Clicked="OnBackClicked"
                    BackgroundColor="#E2E8F0"
                    TextColor="#0F172A"
                    CornerRadius="18"
                    WidthRequest="44"
                    HeightRequest="44" />

            <VerticalStackLayout Grid.Column="1"
                                 Margin="14,0,0,0"
                                 Spacing="2">

                <Label x:Name="TitleLabel"
                       Text="Uploaded CV"
                       FontSize="24"
                       FontAttributes="Bold"
                       TextColor="#0F172A"
                       LineBreakMode="TailTruncation" />

                <Label Text="Preview your uploaded PDF file."
                       FontSize="13"
                       TextColor="#64748B" />
            </VerticalStackLayout>

            <Button Grid.Column="2"
        Text="Export PDF"
        Clicked="OnOpenExternalClicked"
        BackgroundColor="#DCFCE7"
        TextColor="#166534"
        FontAttributes="Bold"
        CornerRadius="16"
        WidthRequest="120"
        HeightRequest="44" />
        </Grid>

        <Border Grid.Row="1"
                BackgroundColor="White"
                Stroke="#E2E8F0"
                StrokeShape="RoundRectangle 24"
                Padding="0">

            <WebView x:Name="PdfWebView" />
        </Border>

    </Grid>
</ContentPage>
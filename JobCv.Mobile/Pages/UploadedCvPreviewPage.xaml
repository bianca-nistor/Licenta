<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="JobCv.Mobile.Pages.UploadedCvPreviewPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#F1F5F9">

    <Grid RowDefinitions="Auto,*"
          Padding="18"
          RowSpacing="18">

        <!-- Header -->
        <Grid Grid.Row="0"
              ColumnDefinitions="*,Auto"
              ColumnSpacing="12"
              Margin="0,26,0,0">


            <VerticalStackLayout Grid.Column="0"
                                 Spacing="4"
                                 VerticalOptions="Start">

                <Label x:Name="TitleLabel"
                       Text="CV Preview"
                       FontSize="28"
                       FontAttributes="Bold"
                       TextColor="#0F172A"
                       MaxLines="2"
                       LineBreakMode="WordWrap" />

                <Label Text="Preview your PDF file inside the app."
                       FontSize="14"
                       TextColor="#64748B"
                       LineBreakMode="WordWrap" />

            </VerticalStackLayout>

            <Button Grid.Column="1"
                    Text="Export"
                    Clicked="OnOpenExternalClicked"
                    BackgroundColor="#DCFCE7"
                    TextColor="#166534"
                    FontAttributes="Bold"
                    CornerRadius="18"
                    HeightRequest="44"
                    WidthRequest="96"
                    VerticalOptions="Start" />

        </Grid>

        <!-- PDF preview card -->
        <Border Grid.Row="1"
                BackgroundColor="White"
                Stroke="#E2E8F0"
                StrokeShape="RoundRectangle 26"
                Padding="10">

            <Grid RowDefinitions="Auto,*"
                  RowSpacing="8">

                <Grid Grid.Row="0"
                      ColumnDefinitions="*,Auto"
                      Padding="6,4">

                    <VerticalStackLayout Spacing="2">

                        <Label Text="PDF preview"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="#0F172A" />

                        <Label x:Name="PreviewMessageLabel"
                               Text="Loading preview..."
                               FontSize="12"
                               TextColor="#64748B"
                               LineBreakMode="WordWrap" />

                    </VerticalStackLayout>

                    <ActivityIndicator x:Name="PreviewLoadingIndicator"
                                       Grid.Column="1"
                                       IsRunning="True"
                                       IsVisible="True"
                                       WidthRequest="28"
                                       HeightRequest="28"
                                       VerticalOptions="Center" />

                </Grid>

                <WebView x:Name="PdfWebView"
                         Grid.Row="1"
                         BackgroundColor="White"
                         Navigating="OnPdfWebViewNavigating"
                         Navigated="OnPdfWebViewNavigated" />

            </Grid>
        </Border>

    </Grid>
</ContentPage>